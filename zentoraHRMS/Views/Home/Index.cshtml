<!-- Interactive Zoho-Style Dashboard Scripts -->
<script>
    $(document).ready(function () {
        // --- 1. Live Current Time Clock ---
        function updateLiveTime() {
            var now = new Date();
            var timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            $('#current-live-time').text(timeStr);
        }
        updateLiveTime();
        setInterval(updateLiveTime, 1000);

        // --- 2. Active Session Work Timer (real-time ticking) ---
        var sessionSeconds = 4 * 3600 + 12 * 60 + 45; // Start value: 04:12:45
        var timerInterval;
        var isClockedIn = true;

        function startTimer() {
            timerInterval = setInterval(function () {
                sessionSeconds++;
                var h = Math.floor(sessionSeconds / 3600).toString().padStart(2, '0');
                var m = Math.floor((sessionSeconds % 3600) / 60).toString().padStart(2, '0');
                var s = (sessionSeconds % 60).toString().padStart(2, '0');
                $('#session-timer').html(h + ':' + m + ':' + s + ' <small class="fs-xs text-muted">Hrs</small>');
            }, 1000);
        }

        if ($('#clock-btn').length > 0 && isClockedIn) {
            startTimer();
        }

        // --- 3. Dynamic Clock In/Out button interaction ---
        $('#clock-btn').on('click', function () {
            var $btn = $(this);
            var status = $btn.attr('data-status');

            if (status === 'checked-in') {
                // Clock out action
                clearInterval(timerInterval);
                isClockedIn = false;
                $btn.attr('data-status', 'checked-out')
                    .removeClass('btn-success')
                    .addClass('btn-primary')
                    .html('<i data-lucide="log-in" class="me-2" style="width:16px;height:16px;"></i> <span>Clock In Now</span>');
                
                $btn.removeClass('pulse-btn');
                $('#clock-in-info').html('<i data-lucide="info" class="me-1 align-text-bottom" style="width:12px;height:12px;display:inline-block;"></i> You clocked out at <strong>' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) + '</strong> today.');
                toastr.info("You have successfully clocked out from your work session.");
            } else {
                // Clock in action
                isClockedIn = true;
                $btn.attr('data-status', 'checked-in')
                    .removeClass('btn-primary')
                    .addClass('btn-success')
                    .html('<i data-lucide="log-out" class="me-2" style="width:16px;height:16px;"></i> <span>Clock Out Now</span>');
                
                $btn.addClass('pulse-btn');
                startTimer();
                var newCheckIn = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                $('#clock-in-info').html('<i data-lucide="info" class="me-1 align-text-bottom" style="width:12px;height:12px;display:inline-block;"></i> You logged in at <strong class="text-success">' + newCheckIn + '</strong> today.');
                toastr.success("Welcome back! Your work session has started.");
            }

            // Re-initialize Lucide icons to draw new icons inside the button
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });

        // --- 4. Interactive Manager Approval Panel ---
        $(document).on('click', '.btn-success, .btn-outline-danger', function (e) {
            var $btn = $(this);
            
            // Ignore click if it's the Work clock button
            if ($btn.attr('id') === 'clock-btn') return;

            e.preventDefault();
            var isApprove = $btn.hasClass('btn-success');
            var $panel = $btn.closest('.p-3.border');

            if (isApprove) {
                toastr.success("Leave request approved successfully.");
            } else {
                toastr.warning("Leave request rejected.");
            }

            // Fade out and remove the panel smoothly
            $panel.fadeOut(400, function () {
                $panel.remove();
                // If no pending elements are left, append placeholder text
                var parentBody = $btn.closest('.card-body');
                if (parentBody.find('.p-3.border').length === 0) {
                    parentBody.append('<p class="text-muted text-center py-4 my-0">No pending leave requests left to approve.</p>');
                }
            });
        });
    });
</script>
        </div>
    }

</div>
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    // Fallbacks and helper variables from database
    var totalEmployees = ViewBag.DbTotalEmployees != null ? ViewBag.DbTotalEmployees.ToString() : "12";
    var totalBranches = ViewBag.DbTotalBranches != null ? ViewBag.DbTotalBranches.ToString() : "9";
    var totalDepartments = ViewBag.DbTotalDepartments != null ? ViewBag.DbTotalDepartments.ToString() : "25";
    var attendanceRate = ViewBag.DbAttendanceRate != null ? string.Format("{0:0.#}%", ViewBag.DbAttendanceRate) : "85.5%";
    var monthlyPayroll = ViewBag.DbMonthlyPayroll != null && Convert.ToDecimal(ViewBag.DbMonthlyPayroll) > 0 
        ? string.Format("${0:n0}", ViewBag.DbMonthlyPayroll) 
        : "$125,000.00";
    var pendingLeaves = ViewBag.DbPendingLeaves != null ? ViewBag.DbPendingLeaves.ToString() : "11";
    var openJobs = ViewBag.DbOpenJobs != null ? ViewBag.DbOpenJobs.ToString() : "13";
    
    var currentUser = Session["UserName"]?.ToString() ?? "User";
}

<!-- ApexCharts Script Tag -->
<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>

<!-- Premium Dashboard Styles -->
<style>
    .dashboard-card {
        border-radius: 12px !important;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px -1px rgba(0, 0, 0, 0.01) !important;
    }
    .dashboard-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px -3px rgba(0, 0, 0, 0.06), 0 4px 6px -2px rgba(0, 0, 0, 0.02) !important;
    }
    
    /* Specific metric card color styles from user reference image */
    .metric-card-payroll {
        background-color: #f0fdf4 !important;
        border: 1px solid rgba(16, 185, 129, 0.2) !important;
    }
    .metric-card-employees {
        background-color: #f0f9ff !important;
        border: 1px solid rgba(59, 130, 246, 0.2) !important;
    }
    .metric-card-branches {
        background-color: #f0fdfa !important;
        border: 1px solid rgba(20, 184, 166, 0.2) !important;
    }
    .metric-card-attendance {
        background-color: #faf5ff !important;
        border: 1px solid rgba(139, 92, 246, 0.2) !important;
    }
    .metric-card-leaves {
        background-color: #fffbeb !important;
        border: 1px solid rgba(245, 158, 11, 0.2) !important;
    }
    .metric-card-jobs {
        background-color: #fef2f2 !important;
        border: 1px solid rgba(239, 68, 68, 0.2) !important;
    }

    .card.bg-white {
        background-color: var(--bs-card-bg, #ffffff) !important;
        border: 1px solid var(--bs-border-color, rgba(0, 0, 0, 0.08)) !important;
        border-radius: 12px !important;
    }
    .card-header.bg-white {
        background-color: transparent !important;
        border-bottom: 1px solid var(--bs-border-color, rgba(0, 0, 0, 0.06)) !important;
    }

    /* Dark Mode overrides for metric cards to retain dark design */
    [data-bs-theme=dark] .metric-card-payroll { background-color: rgba(16, 185, 129, 0.05) !important; }
    [data-bs-theme=dark] .metric-card-employees { background-color: rgba(59, 130, 246, 0.05) !important; }
    [data-bs-theme=dark] .metric-card-branches { background-color: rgba(20, 184, 166, 0.05) !important; }
    [data-bs-theme=dark] .metric-card-attendance { background-color: rgba(139, 92, 246, 0.05) !important; }
    [data-bs-theme=dark] .metric-card-leaves { background-color: rgba(245, 158, 11, 0.05) !important; }
    [data-bs-theme=dark] .metric-card-jobs { background-color: rgba(239, 68, 68, 0.05) !important; }

    [data-bs-theme=dark] .card.bg-white {
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
    }

    /* Welcome Card Styling (Deep Slate Navy) */
    .welcome-hero-card {
        background: #111c2e !important;
        position: relative;
        overflow: hidden;
    }

    /* Starry background violet dots blinking randomly anywhere */
    .starry-dots {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 1;
    }
    .star-dot {
        position: absolute;
        width: 5px;
        height: 5px;
        background-color: #8b5cf6; /* changed to violet */
        border-radius: 50%;
        box-shadow: 0 0 8px #8b5cf6, 0 0 16px rgba(139, 92, 246, 0.7);
        animation: star-twinkle infinite ease-in-out;
        opacity: 0;
    }
    @@keyframes star-twinkle {
        0%, 100% { opacity: 0; transform: scale(0.7); }
        50% { opacity: 0.9; transform: scale(1.3); }
    }

    /* Waving/bouncing violet dots style next to present count text */
    .dot-pulse {
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }
    .dot-pulse span {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        display: inline-block;
    }
    .pulse-dot-active {
        background-color: #8b5cf6; /* changed to violet */
        box-shadow: 0 0 8px rgba(139, 92, 246, 0.6);
        animation: dot-wave 1.2s infinite ease-in-out;
    }
    .pulse-dot-active:nth-child(2) {
        animation-delay: 0.2s;
    }
    .pulse-dot-inactive {
        background-color: rgba(255, 255, 255, 0.25);
    }
    @@keyframes dot-wave {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-4px); }
    }

    /* Three moving wave animations at the bottom of the card - made little faster */
    .three-wave-container {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 40px;
        overflow: hidden;
        pointer-events: none;
        z-index: 2;
    }
    .three-wave {
        position: absolute;
        bottom: 0;
        width: 200%;
        height: 40px;
        background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none"><path d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113-14.29,1200,42.4V0Z" fill="rgba(139,92,246,0.025)"/></svg>') repeat-x; /* subtle violet wave */
        background-size: 50% 100%;
        animation: wave-horizontal 8s linear infinite; /* sped up from 16s */
    }
    .three-wave-middle {
        bottom: 1px;
        height: 34px;
        background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none"><path d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113-14.29,1200,42.4V0Z" fill="rgba(139,92,246,0.015)"/></svg>') repeat-x;
        background-size: 50% 100%;
        animation: wave-horizontal 6s linear infinite reverse; /* sped up from 11s */
    }
    .three-wave-top {
        bottom: 3px;
        height: 26px;
        background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none"><path d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113-14.29,1200,42.4V0Z" fill="rgba(139,92,246,0.008)"/></svg>') repeat-x;
        background-size: 50% 100%;
        animation: wave-horizontal 12s linear infinite; /* sped up from 22s */
    }
    @@keyframes wave-horizontal {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }

    /* Style for buttons inside Career Page pill */
    .career-icon-btn {
        color: rgba(255, 255, 255, 0.45);
        transition: all 0.2s ease;
        background: none;
        border: none;
        padding: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .career-icon-btn:hover {
        color: #ffffff;
        background-color: rgba(255, 255, 255, 0.08);
        border-radius: 4px;
    }
    .vertical-nav-btn {
        transition: all 0.2s ease;
        padding: 4px 8px;
        border-radius: 6px;
    }
    .vertical-nav-btn:hover {
        background-color: rgba(255, 255, 255, 0.04);
        transform: translateY(-2px);
    }
</style>

<div class="container-fluid py-3">
    <!-- Welcome Hero Banner -->
    <div class="card mb-4 border-0 text-white rounded-3 welcome-hero-card shadow-sm">
        <!-- starry backdrop (many violet dots blinking randomly anywhere) -->
        <div class="starry-dots">
            <span class="star-dot" style="top: 15%; left: 10%; animation-delay: 0.2s; animation-duration: 2.5s;"></span>
            <span class="star-dot" style="top: 35%; left: 45%; animation-delay: 0.8s; animation-duration: 3.1s;"></span>
            <span class="star-dot" style="top: 70%; left: 22%; animation-delay: 1.4s; animation-duration: 2.2s;"></span>
            <span class="star-dot" style="top: 20%; left: 78%; animation-delay: 0.5s; animation-duration: 3.5s;"></span>
            <span class="star-dot" style="top: 55%; left: 88%; animation-delay: 1.1s; animation-duration: 2.8s;"></span>
            <span class="star-dot" style="top: 78%; left: 58%; animation-delay: 1.9s; animation-duration: 4.2s;"></span>
            <span class="star-dot" style="top: 45%; left: 15%; animation-delay: 2.3s; animation-duration: 2.7s;"></span>
            <span class="star-dot" style="top: 12%; left: 52%; animation-delay: 0.1s; animation-duration: 3.3s;"></span>
        </div>
        
        <!-- 3 layer wave animations at the bottom (no white background, only waves) -->
        <div class="three-wave-container">
            <div class="three-wave"></div>
            <div class="three-wave-middle"></div>
            <div class="three-wave-top"></div>
        </div>

        <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center position-relative" style="z-index: 10;">
            <!-- Left Side Elements -->
            <div class="mb-3 mb-md-0 d-flex flex-column gap-1">
                <small class="text-white-50 text-uppercase fw-semibold tracking-wider" style="font-size: 11px; letter-spacing: 0.05em; color: rgba(255,255,255,0.4) !important;">GOOD EVENING,</small>
                <h2 class="fw-bold mb-0 text-white" style="font-size: 26px;">@currentUser</h2>
                <p class="mb-1 text-white-50 fs-sm" style="color: rgba(255,255,255,0.4) !important;">Here's what's happening across your company today.</p>
                <div class="d-flex align-items-center gap-2 mt-1">
                    <div class="dot-pulse">
                        <span class="pulse-dot-active"></span>
                        <span class="pulse-dot-active"></span>
                        <span class="pulse-dot-inactive"></span>
                    </div>
                    <span class="fs-xs fw-semibold" style="color: #a78bfa !important;">45 present today</span> <!-- green replaced with violet #a78bfa -->
                </div>
            </div>
            
            <!-- Right Side Elements -->
            <div class="d-flex align-items-center gap-4 flex-wrap">
                <!-- Career Page Pill Box -->
                <div class="d-flex align-items-center rounded-3 px-3 py-2" style="background-color: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08);">
                    <div class="p-2 rounded-3 text-white d-flex align-items-center justify-content-center me-2.5" style="background-color: #8b5cf6; width: 34px; height: 34px;"> <!-- green briefcase replaced with violet #8b5cf6 -->
                        <i data-lucide="briefcase" style="width: 16px; height: 16px;"></i>
                    </div>
                    <div class="me-3">
                        <div class="fw-semibold text-white fs-xs mb-0" style="line-height: 1.2; font-size: 13px;">Career Page</div>
                        <span class="fs-xxs fw-semibold" style="color: #a78bfa !important; font-size: 10px;">13 open</span> <!-- green replaced with violet #a78bfa -->
                    </div>
                    <div class="mx-2" style="width: 1px; height: 24px; background-color: rgba(255, 255, 255, 0.15);"></div> <!-- line dividing the copy/external actions -->
                    <div class="d-flex align-items-center gap-1.5">
                        <button class="career-icon-btn" title="Copy Career Link">
                            <i data-lucide="copy" style="width: 14px; height: 14px;"></i>
                        </button>
                        <a href="#" class="career-icon-btn" title="Open Career Page">
                            <i data-lucide="external-link" style="width: 14px; height: 14px;"></i>
                        </a>
                    </div>
                </div>

                <!-- 3 Vertical navigation buttons -->
                <div class="d-flex align-items-center gap-4">
                    <!-- Jobs -->
                    <a href="@Url.Action("Projects", "CompanyInfo")" class="d-flex flex-column align-items-center text-decoration-none vertical-nav-btn">
                        <i data-lucide="briefcase" class="text-warning mb-1" style="width: 20px; height: 20px; color: #f59e0b !important;"></i>
                        <span class="text-white-50" style="font-size: 11px; color: rgba(255,255,255,0.45) !important;">Jobs</span>
                    </a>
                    
                    <!-- Candidates -->
                    <a href="@Url.Action("Candidates", "Recruitment")" class="d-flex flex-column align-items-center text-decoration-none vertical-nav-btn">
                        <i data-lucide="user-check" class="text-primary mb-1" style="width: 20px; height: 20px; color: #8b5cf6 !important;"></i>
                        <span class="text-white-50" style="font-size: 11px; color: rgba(255,255,255,0.45) !important;">Candidates</span>
                    </a>

                    <!-- Settings -->
                    <a href="@Url.Action("Index", "Settings")" class="d-flex flex-column align-items-center text-decoration-none vertical-nav-btn">
                        <i data-lucide="settings" class="text-muted mb-1" style="width: 20px; height: 20px; color: #94a3b8 !important;"></i>
                        <span class="text-white-50" style="font-size: 11px; color: rgba(255,255,255,0.45) !important;">Settings</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 6 Metrics Row (Applying exact colors and borders from user image) -->
    <div class="row mb-4">
        <!-- Metric 1: Payroll This Month (Green theme) -->
        <div class="col-xl-2 col-md-4 col-sm-6 mb-3">
            <div class="card dashboard-card metric-card-payroll h-100 position-relative">
                <a href="#" class="position-absolute top-0 end-0 p-3" style="z-index: 10;">
                    <i data-lucide="arrow-up-right" class="text-success" style="width: 14px; height: 14px; color: #047857 !important;"></i>
                </a>
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="p-2 rounded-3 d-flex align-items-center justify-content-center" style="background-color: rgba(16, 185, 129, 0.12); color: #047857;">
                            <i data-lucide="credit-card" style="width: 16px; height: 16px;"></i>
                        </div>
                        <span class="text-muted fs-xxs text-uppercase fw-semibold" style="color: #047857 !important; font-size: 10px;">Payroll This Month</span>
                    </div>
                    <h4 class="fw-bold mb-1" style="color: #064e3b !important;">@monthlyPayroll</h4>
                    <small class="fs-xxs" style="color: #047857 !important; opacity: 0.85;">3 runs completed</small>
                </div>
            </div>
        </div>
        <!-- Metric 2: Total Employees (Blue theme) -->
        <div class="col-xl-2 col-md-4 col-sm-6 mb-3">
            <div class="card dashboard-card metric-card-employees h-100 position-relative">
                <a href="#" class="position-absolute top-0 end-0 p-3" style="z-index: 10;">
                    <i data-lucide="arrow-up-right" class="text-primary" style="width: 14px; height: 14px; color: #1d4ed8 !important;"></i>
                </a>
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="p-2 rounded-3 d-flex align-items-center justify-content-center" style="background-color: rgba(59, 130, 246, 0.12); color: #1d4ed8;">
                            <i data-lucide="users" style="width: 16px; height: 16px;"></i>
                        </div>
                        <span class="text-muted fs-xxs text-uppercase fw-semibold" style="color: #1d4ed8 !important; font-size: 10px;">Total Employees</span>
                    </div>
                    <h4 class="fw-bold mb-1" style="color: #1e3a8a !important;">@totalEmployees</h4>
                    <small class="fs-xxs" style="color: #1d4ed8 !important; opacity: 0.85;">↗ 12 this month</small>
                </div>
            </div>
        </div>
        <!-- Metric 3: Branches (Emerald theme) -->
        <div class="col-xl-2 col-md-4 col-sm-6 mb-3">
            <div class="card dashboard-card metric-card-branches h-100 position-relative">
                <a href="#" class="position-absolute top-0 end-0 p-3" style="z-index: 10;">
                    <i data-lucide="arrow-up-right" class="text-teal" style="width: 14px; height: 14px; color: #0f766e !important;"></i>
                </a>
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="p-2 rounded-3 d-flex align-items-center justify-content-center" style="background-color: rgba(20, 184, 166, 0.12); color: #0f766e;">
                            <i data-lucide="building" style="width: 16px; height: 16px;"></i>
                        </div>
                        <span class="text-muted fs-xxs text-uppercase fw-semibold" style="color: #0f766e !important; font-size: 10px;">Branches</span>
                    </div>
                    <h4 class="fw-bold mb-1" style="color: #115e59 !important;">@totalBranches</h4>
                    <small class="fs-xxs" style="color: #0f766e !important; opacity: 0.85;">25 departments</small>
                </div>
            </div>
        </div>
        <!-- Metric 4: Attendance Rate (Purple theme) -->
        <div class="col-xl-2 col-md-4 col-sm-6 mb-3">
            <div class="card dashboard-card metric-card-attendance h-100 position-relative">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="p-2 rounded-3 d-flex align-items-center justify-content-center" style="background-color: rgba(139, 92, 246, 0.12); color: #6d28d9;">
                            <i data-lucide="clock" style="width: 16px; height: 16px;"></i>
                        </div>
                        <span class="text-muted fs-xxs text-uppercase fw-semibold" style="color: #6d28d9 !important; font-size: 10px;">Attendance Rate</span>
                    </div>
                    <h4 class="fw-bold mb-2" style="color: #4c1d95 !important;">@attendanceRate</h4>
                    <!-- Custom progress bar line from reference image -->
                    <div class="progress" style="height: 4px; background-color: rgba(139, 92, 246, 0.1); border-radius: 2px;">
                        <div class="progress-bar" role="progressbar" style="width: 85.5%; background-color: #8b5cf6; border-radius: 2px;"></div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Metric 5: Pending Leaves (Amber/Yellow theme) -->
        <div class="col-xl-2 col-md-4 col-sm-6 mb-3">
            <div class="card dashboard-card metric-card-leaves h-100 position-relative">
                <a href="#" class="position-absolute top-0 end-0 p-3" style="z-index: 10;">
                    <i data-lucide="arrow-up-right" class="text-warning" style="width: 14px; height: 14px; color: #b45309 !important;"></i>
                </a>
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="p-2 rounded-3 d-flex align-items-center justify-content-center" style="background-color: rgba(245, 158, 11, 0.12); color: #b45309;">
                            <i data-lucide="calendar" style="width: 16px; height: 16px;"></i>
                        </div>
                        <span class="text-muted fs-xxs text-uppercase fw-semibold" style="color: #b45309 !important; font-size: 10px;">Pending Leaves</span>
                    </div>
                    <h4 class="fw-bold mb-1" style="color: #78350f !important;">@pendingLeaves</h4>
                    <small class="fs-xxs" style="color: #b45309 !important; opacity: 0.85;">0 on leave today</small>
                </div>
            </div>
        </div>
        <!-- Metric 6: Active Jobs (Rose/Red theme) -->
        <div class="col-xl-2 col-md-4 col-sm-6 mb-3">
            <div class="card dashboard-card metric-card-jobs h-100 position-relative">
                <a href="#" class="position-absolute top-0 end-0 p-3" style="z-index: 10;">
                    <i data-lucide="arrow-up-right" class="text-danger" style="width: 14px; height: 14px; color: #c53030 !important;"></i>
                </a>
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="p-2 rounded-3 d-flex align-items-center justify-content-center" style="background-color: rgba(239, 68, 68, 0.12); color: #c53030;">
                            <i data-lucide="briefcase" style="width: 16px; height: 16px;"></i>
                        </div>
                        <span class="text-muted fs-xxs text-uppercase fw-semibold" style="color: #c53030 !important; font-size: 10px;">Active Jobs</span>
                    </div>
                    <h4 class="fw-bold mb-1" style="color: #7f1d1d !important;">@openJobs</h4>
                    <small class="fs-xxs" style="color: #c53030 !important; opacity: 0.85;">↗ 15 this month</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Birthdays & Today's Leave -->
    <div class="row mb-4">
        <!-- Birthdays -->
        <div class="col-lg-6 mb-3">
            <div class="card bg-white shadow-sm rounded-3 border-light h-100">
                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-semibold text-dark">Today's Birthdays</h5>
                    <i data-lucide="gift" class="text-pink" style="color: #ec4899; width: 18px; height: 18px;"></i>
                </div>
                <div class="card-body py-1">
                    <div class="d-flex flex-column gap-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle bg-soft-primary text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px; font-size: 13px; background-color: rgba(139, 92, 246, 0.1);">DM</div>
                                <div>
                                    <h6 class="mb-0 fw-semibold text-dark fs-sm">Dr. Rowland Murphy</h6>
                                    <small class="text-muted fs-xxs">System Administrator</small>
                                </div>
                            </div>
                            <span class="badge bg-light text-muted rounded-pill fs-xxs px-2.5 py-1">Today</span>
                        </div>

    <!-- Vendor js -->
    <script src="~/assets/js/vendors.min.js"></script>

    <!-- App js -->
    <script src="~/assets/js/app.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
    <script>
        // Setup current theme from config/storage
        function initTheme() {
            var currentTheme = "light";
            var config = sessionStorage.getItem("__SIMPLE_CONFIG__");
            if (config) {
                try {
                    var configObj = JSON.parse(config);
                    if (configObj.theme) {
                        currentTheme = configObj.theme;
                    }
                } catch (e) {}
            } else {
                currentTheme = document.documentElement.getAttribute("data-bs-theme") || "light";
            }
            setTheme(currentTheme);
        }

        function setTheme(theme) {
            document.documentElement.setAttribute("data-bs-theme", theme);
            var config = sessionStorage.getItem("__SIMPLE_CONFIG__");
            var configObj = {};
            if (config) {
                try {
                    configObj = JSON.parse(config);
                } catch (e) {}
            }
            configObj.theme = theme;
            sessionStorage.setItem("__SIMPLE_CONFIG__", JSON.stringify(configObj));
            
            // Toggle sun/moon icons
            if (theme === 'dark') {
                $('#themeToggleBtn .theme-icon-sun').addClass('d-none');
                $('#themeToggleBtn .theme-icon-moon').removeClass('d-none');
            } else {
                $('#themeToggleBtn .theme-icon-sun').removeClass('d-none');
                $('#themeToggleBtn .theme-icon-moon').addClass('d-none');
            }
        }

        $(document).ready(function () {
            // Initialize Lucide icons
            lucide.createIcons();

            // Initialize Theme
            initTheme();

            // Handle Theme Toggle Click
            $("#themeToggleBtn").on("click", function() {
                var currentTheme = document.documentElement.getAttribute("data-bs-theme") || "light";
                var newTheme = currentTheme === "dark" ? "light" : "dark";
                setTheme(newTheme);
            });

            // Showcase Carousel Slideshow
            var currentSlide = 1;
            var slideInterval = setInterval(nextSlide, 5000);

            function showSlide(index) {
                currentSlide = index;
                $(".showcase-slide").removeClass("active");
                $(".showcase-pagination .pagination-dot").removeClass("active");
                
                $(`.showcase-slide[data-slide="${index}"]`).addClass("active");
                $(`.showcase-pagination .pagination-dot[data-slide="${index}"]`).addClass("active");
            }

            function nextSlide() {
                var next = currentSlide + 1;
                if (next > 3) next = 1;
                showSlide(next);
            }

            $(".showcase-pagination .pagination-dot").on("click", function() {
                clearInterval(slideInterval);
                var index = parseInt($(this).data("slide"));
                showSlide(index);
                slideInterval = setInterval(nextSlide, 5000);
            });

            // Password Toggle Visibility
            $("#toggleLoginPasswordBtn").on("click", function () {
                var input = $("#userPassword");
                if (input.attr("type") === "password") {
                    input.attr("type", "text");
                    $(this).find(".eye-open").addClass("d-none");
                    $(this).find(".eye-closed").removeClass("d-none");
                } else {
                    input.attr("type", "password");
                    $(this).find(".eye-open").removeClass("d-none");
                    $(this).find(".eye-closed").addClass("d-none");
                }
            });

            // AJAX Form Submit
            $("#loginForm").on("submit", function (e) {
                e.preventDefault();

                var userIdentifier = $("#userIdentifier").val();
                var password = $("#userPassword").val();

                var $btn = $("#btnLogin");
                var originalHtml = $btn.html();
                
                $btn.prop("disabled", true);
                $btn.html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Logging in...');
                $("#loginError").addClass("d-none");

                $.ajax({
                    url: '/Auth/Login',
                    type: 'POST',
                    data: {
                        UserIdentifier: userIdentifier,
                        Password: password
                    },
                    success: function (response) {
                        if (response.success) {
                            window.location.href = response.redirectUrl;
                        } else {
                            $("#loginErrorMessage").text(response.message);
                            $("#loginError").removeClass("d-none");
                            $btn.prop("disabled", false);
                            $btn.html(originalHtml);
                        }
                    },
                    error: function () {
                        $("#loginErrorMessage").text("An error occurred. Please try again.");
                        $("#loginError").removeClass("d-none");
                        $btn.prop("disabled", false);
                        $btn.html(originalHtml);
                    }
                });
            });
        });
    </script>
    <script>
        // Disable back button after logout
        window.history.forward();
        function noBack() { window.history.forward(); }
    </script>

</body>
</html>
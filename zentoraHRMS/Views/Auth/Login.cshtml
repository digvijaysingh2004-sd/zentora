                                <input type="password" class="form-control" id="userPassword" name="Password" placeholder="Enter password" required autocomplete="current-password">
                                <button class="password-toggle-btn" type="button" id="toggleLoginPasswordBtn">
                                    <i data-lucide="eye" class="eye-open"></i>
                                    <i data-lucide="eye-off" class="eye-closed d-none"></i>

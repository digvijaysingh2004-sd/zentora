            <!-- Right Side: Login Form -->
            <div class="login-form-container">
                <!-- Theme Toggle Button -->
                <button type="button" class="theme-toggle-btn" id="themeToggleBtn" title="Toggle Theme">
                    <i data-lucide="sun" class="theme-icon-sun"></i>
                    <i data-lucide="moon" class="theme-icon-moon d-none"></i>
                </button>

                <div class="form-content text-start">
                    <!-- Branding -->
                    <div class="auth-brand text-center mb-4">
                        <span class="logo-wrapper">
                            <span class="avatar avatar-sm border-0" style="background-color: var(--primary-btn-bg);">
                                <span class="avatar-title">
                                    <i data-lucide="atom" class="logo-icon-atom" style="color: var(--primary-btn-text);"></i>
                                </span>
                            </span>
                            <span class="logo-text fw-bold text-body fs-2xl">ZENTORA</span>
                        </span>
                        <h2 class="auth-title mt-4">Hello Again!</h2>
                        <p class="text-muted text-description mt-2">Enter your email and password to access the workspace.</p>
                    </div>

                    <!-- Form -->
                    <form id="loginForm">
                        <div class="mb-3">
                            <label for="userIdentifier" class="form-label fw-semibold text-secondary-custom">

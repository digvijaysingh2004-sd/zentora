@{
    ViewBag.Title = "Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Sign In | Zentora HRMS</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Zentora Human Resource Management System Login">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- App favicon -->
    <link rel="shortcut icon" href="~/assets/images/favicon.ico">

    <!-- Theme Config Js -->
    <script src="~/assets/js/config.js"></script>

    <!-- Vendor css -->
    <link href="~/assets/css/vendors.min.css" rel="stylesheet" type="text/css">

    <!-- App css -->
    <link href="~/assets/css/app.min.css" rel="stylesheet" type="text/css">

    <!-- Lucide Icons -->
    <script src="~/assets/plugins/lucide/lucide.min.js"></script>

    <style>
        :root {
            --bg-gradient-start: #faf9ff;
            --bg-gradient-end: #f5f3ff;
            --card-bg: #ffffff;
            --card-border: rgba(139, 92, 246, 0.08);
            --card-shadow: 0 15px 35px -10px rgba(139, 92, 246, 0.12), 0 1px 3px rgba(139, 92, 246, 0.02);
            --text-main: #1f1b2d;
            --text-muted: #6b7280;
            --text-muted-custom: #6b7280;
            --input-bg: #fafafc;
            --input-border: #e4e3eb;
            --input-focus-border: #8b5cf6;
            --input-focus-ring: rgba(139, 92, 246, 0.18);
            --primary-btn-bg: #8b5cf6;
            --primary-btn-hover: #7c3aed;
            --primary-btn-text: #ffffff;
            --google-btn-bg: #ffffff;
            --google-btn-border: #e4e3eb;
            --google-btn-text: #4b5563;
            --google-btn-hover: #fafafc;
            --accent-blue: #8b5cf6;
            --showcase-bg: linear-gradient(135deg, #4c1d95 0%, #7c3aed 50%, #8b5cf6 100%);
            --card-graphic-bg: rgba(255, 255, 255, 0.08);
            --card-graphic-border: rgba(255, 255, 255, 0.15);
            --secondary-custom: #4b5563;
        }

        [data-bs-theme=dark] {
            --bg-gradient-start: #0a0518;
            --bg-gradient-end: #120b24;
            --card-bg: #1b132e;
            --card-border: rgba(255, 255, 255, 0.05);
            --card-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6), 0 1px 2px rgba(255, 255, 255, 0.01);
            --text-main: #f3f4f6;
            --text-muted: #9ca3af;
            --text-muted-custom: #9ca3af;
            --input-bg: #221a3a;
            --input-border: #352a5a;
            --input-focus-border: #a78bfa;
            --input-focus-ring: rgba(167, 139, 250, 0.25);
            --primary-btn-bg: #8b5cf6;
            --primary-btn-hover: #a78bfa;
            --primary-btn-text: #ffffff;
            --google-btn-bg: #221a3a;
            --google-btn-border: #352a5a;
            --google-btn-text: #e5e7eb;
            --google-btn-hover: #2a2047;
            --accent-blue: #a78bfa;
            --showcase-bg: linear-gradient(135deg, #0e051c 0%, #20113b 100%);
            --card-graphic-bg: rgba(0, 0, 0, 0.4);
            --card-graphic-border: rgba(255, 255, 255, 0.08);
            --secondary-custom: #9ca3af;
        }

        body, html {
            margin: 0;
            padding: 0;
            font-family: 'Outfit', 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            height: 100%;
            overflow: hidden !important; /* completely hides browser scrollbar on desktop */
            background: #faf9ff; /* default fallback */
            transition: background 0.3s ease;
        }

        @@media (max-width: 991px) {
            body, html {
                overflow-y: auto !important; /* enables scrollbar on tablet/mobile if content overflows */
            }
        }

        .login-wrapper {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            z-index: 1;
            background: radial-gradient(circle at top right, var(--bg-gradient-start), var(--bg-gradient-end)) !important;
            overflow: hidden;
        }

        /* Subtle Grid Pattern Overlay */
        .grid-overlay {
            position: absolute;
            inset: 0;
            background-image: linear-gradient(var(--card-border) 1.5px, transparent 1.5px),
                              linear-gradient(90deg, var(--card-border) 1.5px, transparent 1.5px);
            background-size: 60px 60px;
            opacity: 0.65;
            z-index: 2; /* above background gradient, below blobs */
            pointer-events: none;
        }

        /* Floating background blobs - now highly visible */
        .blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(90px);
            z-index: 3; /* above background & grid, below card */
            opacity: 0.55;
            animation: floatBlob 22s infinite alternate ease-in-out;
            pointer-events: none;
        }
        .blob-1 {
            width: 320px;
            height: 320px;
            background: rgba(155, 89, 182, 0.22); /* brand purple */
            top: 8%;
            left: 8%;
        }
        .blob-2 {
            width: 280px;
            height: 280px;
            background: rgba(99, 102, 241, 0.18); /* indigo */
            bottom: 12%;
            right: 12%;
            animation-delay: -5s;
        }
        .blob-3 {
            width: 220px;
            height: 220px;
            background: rgba(236, 72, 153, 0.14); /* soft pink */
            top: 48%;
            right: 38%;
            animation-delay: -11s;
        }

        @@keyframes floatBlob {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(50px, 50px) scale(1.15); }
        }

        /* Symmetrical Login Card */
        .login-card {
            position: relative;
            z-index: 4; /* above blobs */
            display: flex;
            width: 960px;
            max-width: 100%;
            min-height: 560px;
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 24px;
            box-shadow: var(--card-shadow);
            overflow: hidden;
            transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
        }

        /* Showcase Banner (Left) */
        .login-showcase {
            flex: 1; /* symmetrical 50% split */
            background: var(--showcase-bg);
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            overflow: hidden;
            transition: background 0.3s ease;
        }

        .login-showcase::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at top right, rgba(255,255,255,0.06), transparent 60%);
            pointer-events: none;
        }

        .showcase-content {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            height: 100%;
            justify-content: space-between;
        }

        .showcase-slides {
            position: relative;
            min-height: 330px;
        }

        .showcase-slide {
            position: absolute;
            inset: 0;
            opacity: 0;
            visibility: hidden;
            transform: translateY(20px);
            transition: opacity 0.6s ease, transform 0.6s ease, visibility 0.6s;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .showcase-slide.active {
            position: relative;
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .showcase-graphic {
            position: relative;
            height: 200px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Graphic Cards Layout with floating/rotating animations */
        .graphic-card {
            background: var(--card-graphic-bg);
            border: 1px solid var(--card-graphic-border);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-radius: 16px;
            padding: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            position: absolute;
            transition: transform 0.5s ease;
        }

        .card-main {
            width: 250px;
            z-index: 3;
            transform: translate(-10px, -10px);
            animation: floatGraphic1 6s infinite alternate ease-in-out;
        }

        .card-secondary {
            width: 170px;
            right: 10%;
            top: 5%;
            z-index: 2;
            transform: translate(15px, 0);
            animation: floatGraphic2 6s infinite alternate ease-in-out;
            animation-delay: -2s;
        }

        .card-tertiary {
            width: 165px;
            left: 10%;
            bottom: 0;
            z-index: 4;
            transform: translate(-20px, 15px);
            animation: floatGraphic3 6s infinite alternate ease-in-out;
            animation-delay: -4s;
        }

        @@keyframes floatGraphic1 {
            0% { transform: translate(-10px, -12px) rotate(0deg); }
            100% { transform: translate(-10px, -22px) rotate(1deg); }
        }

        @@keyframes floatGraphic2 {
            0% { transform: translate(15px, 6px) rotate(0deg); }
            100% { transform: translate(15px, -4px) rotate(-1deg); }
        }

        @@keyframes floatGraphic3 {
            0% { transform: translate(-20px, 18px) rotate(0deg); }
            100% { transform: translate(-20px, 8px) rotate(1deg); }
        }

        .card-header-custom {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .avatar-mock {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .avatar-mock i {
            width: 16px;
            height: 16px;
        }

        .avatar-mock-sm {
            width: 20px;
            height: 20px;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .showcase-title {
            color: #ffffff;
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .showcase-desc {
            color: rgba(255, 255, 255, 0.75);
            font-size: 13.5px;
            line-height: 1.5;
            margin: 0;
            max-width: 90%;
        }

        .showcase-pagination {
            display: flex;
            gap: 8px;
            margin-top: 16px;
        }

        .pagination-dot {
            width: 20px;
            height: 4px;
            border-radius: 2px;
            background: rgba(255, 255, 255, 0.25);
            cursor: pointer;
            transition: background 0.3s ease, width 0.3s ease;
        }

        .pagination-dot.active {
            background: #ffffff;
            width: 32px;
        }

        /* Form Panel (Right) */
        .login-form-container {
            flex: 1; /* symmetrical 50% split */
            padding: 40px;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .theme-toggle-btn {
            position: absolute;
            top: 24px;
            right: 24px;
            background: var(--input-bg);
            border: 1px solid var(--input-border);
            color: var(--text-main);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            z-index: 10;
        }

        .theme-toggle-btn:hover {
            background: var(--google-btn-hover);
            transform: scale(1.05);
        }

        .theme-toggle-btn i {
            width: 18px;
            height: 18px;
        }

        .logo-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .logo-icon-atom {
            width: 22px;
            height: 22px;
            animation: rotateAtom 8s linear infinite;
        }

        @@keyframes rotateAtom {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .auth-title {
            color: var(--text-main);
            font-size: 26px;
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        .text-description {
            color: var(--text-muted);
            font-size: 13.5px;
        }

        /* Input Controls */
        .input-group-custom {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-icon {
            position: absolute;
            left: 14px;
            color: var(--text-muted);
            pointer-events: none;
            display: flex;
            align-items: center;
        }

        .input-icon i {
            width: 18px;
            height: 18px;
        }

        .input-group-custom .form-control {
            background: var(--input-bg) !important;
            border: 1px solid var(--input-border) !important;
            color: var(--text-main) !important;
            border-radius: 12px !important;
            padding: 12px 14px 12px 42px !important;
            width: 100%;
            font-size: 14px;
            transition: all 0.25s ease;
        }
        .input-group-custom .form-control:focus {
            background: var(--card-bg) !important;
            border-color: var(--input-focus-border) !important;
            box-shadow: none !important;
            outline: none;
        }

        .input-group-custom .form-control::placeholder {
            color: var(--text-muted);
            opacity: 0.6;
        }

        .password-toggle-btn {
            position: absolute;
            right: 14px;
            background: none;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            padding: 0;
            display: flex;
            align-items: center;
            z-index: 10;
        }

        .password-toggle-btn:hover {
            color: var(--text-main);
        }

        .password-toggle-btn i {
            width: 18px;
            height: 18px;
        }

        .text-secondary-custom {
            color: var(--text-main);
            font-size: 13px;
            margin-bottom: 6px;
        }

        /* Custom Checkbox */
        .form-check-custom {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .form-check-input-custom {
            width: 16px;
            height: 16px;
            border-radius: 4px;
            border: 1.5px solid var(--input-border);
            background: var(--input-bg);
            cursor: pointer;
            appearance: none;
            -webkit-appearance: none;
            position: relative;
            transition: all 0.2s;
        }

        .form-check-input-custom:checked {
            background-color: var(--accent-blue);
            border-color: var(--accent-blue);
        }

        .form-check-input-custom:checked::after {
            content: '';
            position: absolute;
            width: 5px;
            height: 9px;
            border: solid white;
            border-width: 0 2px 2px 0;
            transform: rotate(45deg);
            top: 1px;
            left: 4.5px;
        }

        .form-check-label-custom {
            font-size: 13px;
            color: var(--text-muted-custom);
            cursor: pointer;
            user-select: none;
            margin-bottom: 0;
        }

        .forgot-password-link {
            font-size: 13px;
            color: var(--accent-blue);
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s;
        }

        .forgot-password-link:hover {
            color: var(--primary-btn-hover);
        }

        /* Buttons */
        .btn-primary-custom {
            background: var(--primary-btn-bg);
            color: var(--primary-btn-text);
            border: none;
            border-radius: 12px;
            font-size: 15px;
            transition: all 0.25s ease;
            box-shadow: 0 4px 12px rgba(155, 89, 182, 0.2);
        }

        .btn-primary-custom:hover {
            background: var(--primary-btn-hover);
            color: var(--primary-btn-text);
            box-shadow: 0 6px 16px rgba(155, 89, 182, 0.3);
            transform: translateY(-1px);
        }

        .btn-primary-custom:active {
            transform: translateY(0);
        }

        .btn-primary-custom:disabled {
            opacity: 0.75;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        .divider-custom {
            display: flex;
            align-items: center;
            text-align: center;
            color: var(--text-muted);
            font-size: 12px;
            margin: 18px 0;
        }

        .divider-custom::before, .divider-custom::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid var(--input-border);
        }

        .divider-custom:not(:empty)::before {
            margin-right: .5em;
        }

        .divider-custom:not(:empty)::after {
            margin-left: .5em;
        }

        .btn-google-custom {
            background: var(--google-btn-bg);
            border: 1px solid var(--google-btn-border);
            color: var(--google-btn-text);
            border-radius: 12px;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: all 0.25s ease;
        }

        .btn-google-custom:hover {
            background: var(--google-btn-hover);
            transform: translateY(-1px);
        }

        .btn-google-custom:active {
            transform: translateY(0);
        }

        .google-icon {
            display: block;
        }

        /* Custom Alert */
        .alert-error-custom {
            background: rgba(239, 68, 68, 0.08);
            border: 1px solid rgba(239, 68, 68, 0.15);
            color: #ef4444;
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 8px;
            animation: shake 0.4s ease;
        }

        [data-bs-theme=dark] .alert-error-custom {
            background: rgba(248, 113, 113, 0.08);
            border: 1px solid rgba(248, 113, 113, 0.15);
            color: #f87171;
        }

        .alert-icon {
            width: 16px;
            height: 16px;
            flex-shrink: 0;
        }

        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-4px); }
            75% { transform: translateX(4px); }
        }

        /* Responsive */
        @@media (max-width: 991px) {
            .login-card {
                width: 480px;
                min-height: auto;
            }
            .login-showcase {
                display: none;
            }
        }

        @@media (max-width: 576px) {
            .login-card {
                border-radius: 18px;
            }
            .login-form-container {
                padding: 30px 20px;
            }
            .theme-toggle-btn {
                top: 16px;
                right: 16px;
            }
        }
    </style>
</head>

<body onload="noBack();" onpageshow="if (event.persisted) noBack();">

    <div class="login-wrapper">
        <!-- Subtle Background Grid Pattern -->
        <div class="grid-overlay"></div>

        <!-- Floating Background Blobs -->
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
        <div class="blob blob-3"></div>

        <div class="login-card">
            <!-- Left Side: HRMS Showcase -->
            <div class="login-showcase">
                <div class="showcase-content">
                    <div class="showcase-slides">
                        <!-- Slide 1: General Core HR -->
                        <div class="showcase-slide active" data-slide="1">
                            <div class="showcase-graphic">
                                <div class="graphic-card card-main">
                                    <div class="card-header-custom">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar-mock text-bg-success-subtle">
                                                <i data-lucide="user-check" class="text-success"></i>
                                            </div>
                                            <div class="text-start">
                                                <div class="fw-semibold text-white fs-xs">Active Staff</div>
                                                <div class="text-white-50 fs-xxs">Current Shift</div>
                                            </div>
                                        </div>
                                        <span class="badge bg-success-subtle text-success border-0 px-2 py-0.5" style="font-size: 9px;">On Time</span>
                                    </div>
                                    <div class="card-body-custom mt-3 text-start">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="text-white-50 fs-xxs">Check-in time:</span>
                                            <span class="fw-medium text-white fs-xxs">09:00 AM</span>
                                        </div>
                                        <div class="progress mt-2" style="height: 5px; background: rgba(255, 255, 255, 0.1);">
                                            <div class="progress-bar bg-success" style="width: 100%;"></div>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="graphic-card card-secondary text-start">
                                    <div class="fw-semibold text-white fs-xs mb-1">Performance Goal</div>
                                    <div class="text-white-50 fs-xxs mb-2">Q3 Retention Target</div>
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="text-success fw-semibold fs-xxs">85% Achieved</span>
                                        <div class="spinner-grow spinner-grow-sm text-success" role="status" style="width: 6px; height: 6px;"></div>
                                    </div>
                                </div>

                                <div class="graphic-card card-tertiary text-start">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <div class="avatar-mock-sm text-bg-primary-subtle">
                                            <i data-lucide="award" class="text-primary" style="width: 10px; height: 10px;"></i>
                                        </div>
                                        <span class="fw-medium text-white fs-xxs">Goal Approved</span>
                                    </div>
                                    <div class="text-white-50 fs-xxs">Policy review completed.</div>
                                </div>
                            </div>
                            <h3 class="showcase-title">Empower Your Workforce</h3>
                            <p class="showcase-desc">Track shifts, manage team leave operations, and align corporate objectives in one unified workspace.</p>
                        </div>

                        <!-- Slide 2: Recruitment & Pipelines -->
                        <div class="showcase-slide" data-slide="2">
                            <div class="showcase-graphic">
                                <div class="graphic-card card-main text-start">
                                    <div class="card-header-custom">
                                        <div class="fw-semibold text-white fs-xs">Candidate Pipeline</div>
                                        <span class="badge bg-primary-subtle text-primary border-0 px-2 py-0.5" style="font-size: 9px;">Active</span>
                                    </div>
                                    <div class="card-body-custom mt-3">
                                        <div class="pipeline-item mb-2 text-start">
                                            <div class="d-flex justify-content-between fs-xxs text-white-50">
                                                <span>Technical Assessment</span>
                                                <span>80% Match</span>
                                            </div>
                                            <div class="progress mt-1" style="height: 4px; background: rgba(255, 255, 255, 0.1);">
                                                <div class="progress-bar bg-primary" style="width: 80%;"></div>
                                            </div>
                                        </div>
                                        <div class="pipeline-item text-start">
                                            <div class="d-flex justify-content-between fs-xxs text-white-50">
                                                <span>Management Review</span>
                                                <span>95% Match</span>
                                            </div>
                                            <div class="progress mt-1" style="height: 4px; background: rgba(255, 255, 255, 0.1);">
                                                <div class="progress-bar bg-success" style="width: 95%;"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="graphic-card card-secondary text-start">
                                    <div class="fw-semibold text-white fs-xs mb-1">Interview Round 2</div>
                                    <div class="text-white-50 fs-xxs mb-2">Starts in 15 mins</div>
                                    <div class="d-flex align-items-center gap-1 text-white fs-xxs" style="font-size: 9px;">

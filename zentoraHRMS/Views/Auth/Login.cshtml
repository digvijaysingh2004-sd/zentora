                            </label>
                            <div class="input-group-custom">
                                <div class="input-icon">
                                    <i data-lucide="mail"></i>
                                </div>
                                <input type="text" class="form-control" id="userIdentifier" name="UserIdentifier"
                                       placeholder="Enter email, username or phone" required autocomplete="username">

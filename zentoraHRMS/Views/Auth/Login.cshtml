                    </form>

                    <!-- Error Alert -->
                    <div id="loginError" class="alert-error-custom d-none mt-3">
                        <i data-lucide="alert-circle" class="alert-icon"></i>
                        <span id="loginErrorMessage">Invalid credentials!</span>
                    </div>

                    <!-- Footer Sign up -->
                    <div class="text-center mt-4">
                        <span class="text-muted-custom text-xs">Don't have an account yet?</span>

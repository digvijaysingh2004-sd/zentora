@model IEnumerable<zentoraHRMS.Models.IndicatorModel>
@{
    ViewBag.Title = "Indicators";
}

<div class="container-fluid">
    <div class="row justify-content-center py-5">
        <div class="col-xxl-5 col-xl-7 text-center">
            <a href="@Url.Action("Index","Home")" class="badge badge-default fw-normal shadow px-2 py-1 mb-2 fst-italic fs-xxs">
                <i data-lucide="square-check" class="fs-sm me-1"></i> DashBoard
            </a>
            <h3 class="fw-bold">Key Performance Indicators</h3>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-xxl-12">
            <div class="card rounded-2">
                <div class="card-header justify-content-between">
                    <h5 class="card-title">Indicator Details</h5>
                    <button type="button" class="btn btn-sm btn-soft-primary" data-bs-toggle="modal" data-bs-target="#AddIndicator">
                        <i class="me-1" data-lucide="plus"></i> Add Indicator
                    </button>
                </div>

                <div class="card-body">
                    <table id="checkbox-select-data" class="table table-striped dt-responsive checkbox-select-datatable align-middle mb-0">
                        <thead class="thead-sm text-uppercase fs-xxs">
                            <tr>
                                <th class="fs-sm" style="width: 1%;"></th>
                                <th>Indicator ID</th>
                                <th>Category</th>
                                <th>Indicator Name</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th>Created By</th>
                                <th>Created Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model)
                            {
                                <tr>
                                    <td class="fs-sm" style="width: 1%;"></td>
                                    <td>@c.IndicatorId</td>
                                    <td>@c.CategoryName</td>
                                    <td>@c.IndicatorName</td>
                                    <td>@c.Description</td>
                                    <td>
                                        @if (c.IsActive) { <span class="badge bg-success-subtle text-success">Active</span> }
                                        else { <span class="badge bg-danger-subtle text-danger">Inactive</span> }
                                    </td>
                                    <td>@c.CreatedBy</td>
                                    <td>@(c.CreatedAt.HasValue ? c.CreatedAt.Value.ToString("yyyy-MM-dd HH:mm") : "")</td>
                                    <td>
                                        <a onclick="UpdateIndicator(@c.IndicatorId)" class="btn btn-sm btn-soft-info mt-1" title="Update"><i data-lucide="square-pen"></i></a>
                                        <a onclick="DeleteIndicator(@c.IndicatorId)" class="btn btn-sm btn-soft-danger mt-1" title="Delete"><i data-lucide="trash-2"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- AddIndicator Modal -->
    <div id="AddIndicator" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="IndicatorForm" class="needs-validation" novalidate method="post">
                    <div class="modal-header">
                        <h4 class="modal-title">Add Indicator</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="IndicatorCategoryId" class="form-label">Indicator Category <span class="text-danger">*</span></label>
                            <select class="form-select" id="IndicatorCategoryId" required>
                                <option value="">Select Category</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="IndicatorName" class="form-label">Indicator Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="IndicatorName" required>
                        </div>
                        <div class="mb-3">
                            <label for="Description" class="form-label">Description</label>
                            <textarea class="form-control" id="Description" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="IsActive" class="form-label">Status</label>
                            <select class="form-select" id="IsActive">
                                <option value="true" selected>Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-soft-primary">Save changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- UpdateIndicator Modal -->
    <div id="UpdateIndicatorModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="UpdateIndicatorForm" class="needs-validation" novalidate method="post">
                    <div class="modal-header">
                        <h4 class="modal-title">Update Indicator</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="update_id" />
                        <div class="mb-3">
                            <label for="uIndicatorCategoryId" class="form-label">Indicator Category <span class="text-danger">*</span></label>
                            <select class="form-select" id="uIndicatorCategoryId" required>
                                <option value="">Select Category</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="uIndicatorName" class="form-label">Indicator Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="uIndicatorName" required>
                        </div>
                        <div class="mb-3">
                            <label for="uDescription" class="form-label">Description</label>
                            <textarea class="form-control" id="uDescription" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="uIsActive" class="form-label">Status</label>
                            <select class="form-select" id="uIsActive">
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-soft-primary">Save changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        LoadCategories();

        $("#IndicatorForm").on("submit", function (e) {
            e.preventDefault();
            var formData = {
                IndicatorCategoryId: $("#IndicatorCategoryId").val(),
                IndicatorName: $("#IndicatorName").val(),
                Description: $("#Description").val(),
                IsActive: $("#IsActive").val() === "true"
            };
            $.ajax({
                url: '/Performance/SaveIndicator',
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(formData),
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert("Error: " + res.message);
                    }
                }
            });
        });

        $("#UpdateIndicatorForm").on("submit", function (e) {
            e.preventDefault();
            var formData = {
                IndicatorId: $("#update_id").val(),
                IndicatorCategoryId: $("#uIndicatorCategoryId").val(),
                IndicatorName: $("#uIndicatorName").val(),
                Description: $("#uDescription").val(),
                IsActive: $("#uIsActive").val() === "true"
            };
            $.ajax({
                url: '/Performance/UpdateIndicator',
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(formData),
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert("Error: " + res.message);
                    }
                }
            });
        });
    });

    function LoadCategories() {
        $.ajax({
            url: '/Performance/GetIndicatorCategoriesList',
            type: 'GET',
            success: function (data) {
                var selectAdd = $("#IndicatorCategoryId");
                var selectEdit = $("#uIndicatorCategoryId");
                
                selectAdd.empty().append('<option value="">Select Category</option>');
                selectEdit.empty().append('<option value="">Select Category</option>');
                
                $.each(data, function (i, item) {
                    var optionHtml = '<option value="' + item.IndicatorCategoryId + '">' + item.CategoryName + '</option>';
                    selectAdd.append(optionHtml);
                    selectEdit.append(optionHtml);
                });
            }
        });
    }

    function UpdateIndicator(id) {
        $.ajax({
            url: '/Performance/GetIndicatorById',
            type: 'GET',
            data: { id: id },
            success: function (data) {
                if (data) {
                    $("#update_id").val(data.IndicatorId);
                    $("#uIndicatorCategoryId").val(data.IndicatorCategoryId);
                    $("#uIndicatorName").val(data.IndicatorName);
                    $("#uDescription").val(data.Description);
                    $("#uIsActive").val(data.IsActive.toString());
                    $("#UpdateIndicatorModal").modal("show");
                }
            }
        });
    }

    function DeleteIndicator(id) {
        if (confirm("Are you sure you want to delete this indicator?")) {
            $.ajax({
                url: '/Performance/DeleteIndicator',
                type: "POST",
                data: { id: id },
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert("Error: " + res.message);
                    }
                }
            });
        }
    }
</script>

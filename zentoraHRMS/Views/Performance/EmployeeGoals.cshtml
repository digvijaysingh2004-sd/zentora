@model IEnumerable<zentoraHRMS.Models.EmployeeGoalModel>
@{
    ViewBag.Title = "Employee Goals";
}

<div class="container-fluid">
    <div class="row justify-content-center py-5">
        <div class="col-xxl-6 col-xl-8 text-center">
            <a href="@Url.Action("Index","Home")" class="badge badge-default fw-normal shadow px-2 py-1 mb-2 fst-italic fs-xxs">
                <i data-lucide="square-check" class="fs-sm me-1"></i> DashBoard
            </a>
            <h3 class="fw-bold text-gradient">Employee Goals Management</h3>
            <p class="text-muted">Establish targets, monitor key results, track progress percentage, and align company objectives with employee accomplishments.</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-xxl-12">
            <div class="card rounded-3 border-0 shadow-sm">
                <div class="card-header justify-content-between align-items-center d-flex bg-white py-3">
                    <h5 class="card-title mb-0 fw-semibold text-dark">Employee Goals</h5>
                    <button type="button" class="btn btn-sm btn-soft-primary px-3 py-1.5 rounded-2 d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#AddEmployeeGoalModal">
                        <i class="me-1" data-lucide="plus" style="width: 16px; height: 16px;"></i> Add Goal
                    </button>
                </div>

                <div class="card-body">
                    <div class="table-responsive">
                        <table id="employee-goals-table" class="table table-hover dt-responsive align-middle mb-0">
                            <thead class="thead-sm text-uppercase fs-xxs text-muted bg-light">
                                <tr>
                                    <th>Employee</th>
                                    <th>Goal Type</th>
                                    <th>Goal Title</th>
                                    <th>Timeline</th>
                                    <th>Target & Progress</th>
                                    <th>Status</th>
                                    <th style="width: 10%;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model == null || !Model.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">
                                            <i data-lucide="info" class="mb-2 text-warning" style="width: 32px; height: 32px;"></i>
                                            <p class="mb-0">No goals found. Click "Add Goal" to set one up!</p>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var g in Model)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold text-dark fs-sm">@g.EmployeeName</div>
                                                <div class="text-muted fs-xxs">ID: #@g.EmployeeId</div>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-secondary border border-light-subtle rounded-pill px-2.5 py-1">@g.GoalTypeName</span>
                                            </td>
                                            <td>
                                                <div class="fw-semibold text-dark fs-sm">@g.GoalTitle</div>
                                                <div class="text-muted fs-xs mt-1 desc-container">
                                                    @if (string.IsNullOrEmpty(g.Description))
                                                    {
                                                        <span>-</span>
                                                    }
                                                    else if (g.Description.Length > 80)
                                                    {
                                                        <span class="desc-short">@g.Description.Substring(0, 80)...</span>
                                                        <span class="desc-full d-none">@g.Description</span>
                                                        <a href="javascript:void(0);" class="text-primary ms-1 toggle-desc fs-xxs fw-medium" onclick="ToggleDescription(this)">Show More</a>
                                                    }
                                                    else
                                                    {
                                                        <span>@g.Description</span>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <div class="fs-xs text-dark"><span class="text-muted">Start:</span> @(g.StartDate.HasValue ? g.StartDate.Value.ToString("MMM dd, yyyy") : "-")</div>
                                                <div class="fs-xs text-dark mt-0.5"><span class="text-muted">End:</span> @(g.EndDate.HasValue ? g.EndDate.Value.ToString("MMM dd, yyyy") : "-")</div>
                                            </td>
                                            <td>
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="text-muted fs-xxs fst-italic">Target: @(string.IsNullOrEmpty(g.Target) ? "-" : g.Target)</span>
                                                    <span class="fw-bold text-dark fs-xxs">@g.Progress%</span>
                                                </div>
                                                <div class="progress progress-sm rounded-pill" style="height: 6px; background-color: #f0f0f5;">
                                                    @{
                                                        string progressBg = "bg-primary";
                                                        if (g.Progress >= 100) { progressBg = "bg-success"; }
                                                        else if (g.Progress >= 75) { progressBg = "bg-info"; }
                                                        else if (g.Progress >= 35) { progressBg = "bg-warning"; }
                                                        else { progressBg = "bg-danger"; }
                                                    }
                                                    <div class="progress-bar @progressBg rounded-pill progress-bar-striped progress-bar-animated" role="progressbar" style="width: @g.Progress%" aria-valuenow="@g.Progress" aria-valuemin="0" aria-valuemax="100"></div>
                                                </div>
                                            </td>
                                            <td>
                                                @switch (g.Status)
                                                {
                                                    case "Completed":
                                                    case "Achieved":
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded">@g.Status</span>
                                                        break;
                                                    case "In Progress":
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded">@g.Status</span>
                                                        break;
                                                    case "Deferred":
                                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1 rounded">@g.Status</span>
                                                        break;
                                                    case "Cancelled":
                                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded">@g.Status</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1 rounded">@g.Status</span>
                                                        break;
                                                }
                                                @if (g.SystemAddon)
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary ms-1" style="font-size: 9px;">System</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="d-flex gap-1">
                                                    <button type="button" onclick="UpdateGoal(@g.EmployeeGoalId)" class="btn btn-sm btn-soft-info d-inline-flex align-items-center justify-content-center p-1.5" title="Edit">
                                                        <i data-lucide="square-pen" style="width: 14px; height: 14px;"></i>
                                                    </button>
                                                    <button type="button" onclick="DeleteGoal(@g.EmployeeGoalId)" class="btn btn-sm btn-soft-danger d-inline-flex align-items-center justify-content-center p-1.5" title="Delete">
                                                        <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Employee Goal Modal -->
    <div id="AddEmployeeGoalModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="AddEmployeeGoalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg">
                <form id="AddGoalForm" class="needs-validation" novalidate method="post">
                    <div class="modal-header bg-light py-3 border-bottom border-light-subtle">
                        <h5 class="modal-title fw-bold text-dark" id="AddEmployeeGoalLabel">Add Employee Goal</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="EmployeeId" class="form-label fw-medium">Employee <span class="text-danger">*</span></label>
                                <select class="form-select select-employee" id="EmployeeId" required>
                                    <option value="" disabled selected>Select Employee...</option>
                                </select>
                                <div class="invalid-feedback">Please select an employee.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="GoalTypeId" class="form-label fw-medium">Goal Type <span class="text-danger">*</span></label>
                                <select class="form-select select-goaltype" id="GoalTypeId" required>
                                    <option value="" disabled selected>Select Goal Type...</option>
                                </select>
                                <div class="invalid-feedback">Please select a goal type.</div>
                            </div>
                            <div class="col-12">
                                <label for="GoalTitle" class="form-label fw-medium">Goal Title <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="GoalTitle" placeholder="e.g., Implement OAuth Authentication System" required>
                                <div class="invalid-feedback">Please enter a goal title.</div>
                            </div>
                            <div class="col-12">
                                <label for="Description" class="form-label fw-medium">Description</label>
                                <textarea class="form-control" id="Description" rows="3" placeholder="Provide details about the deliverables, scope, and parameters of the goal..."></textarea>
                            </div>
                            <div class="col-md-6">
                                <label for="StartDate" class="form-label fw-medium">Start Date</label>
                                <input type="date" class="form-control" id="StartDate">
                            </div>
                            <div class="col-md-6">
                                <label for="EndDate" class="form-label fw-medium">End Date</label>
                                <input type="date" class="form-control" id="EndDate">
                            </div>
                            <div class="col-md-6">
                                <label for="Target" class="form-label fw-medium">Target / Key Result</label>
                                <input type="text" class="form-control" id="Target" placeholder="e.g., 98% uptime / 5 modules completed">
                            </div>
                            <div class="col-md-3">
                                <label for="Progress" class="form-label fw-medium">Progress (%)</label>
                                <input type="number" class="form-control" id="Progress" min="0" max="100" value="0">
                            </div>
                            <div class="col-md-3">
                                <label for="Status" class="form-label fw-medium">Status</label>
                                <select class="form-select" id="Status">
                                    <option value="Active" selected>Active</option>
                                    <option value="In Progress">In Progress</option>
                                    <option value="Completed">Completed</option>
                                    <option value="Deferred">Deferred</option>
                                    <option value="Cancelled">Cancelled</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light py-2 border-top border-light-subtle">
                        <button type="button" class="btn btn-light px-3 py-1.5" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-primary px-4 py-1.5 shadow-sm">Save Goal</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Update Employee Goal Modal -->
    <div id="UpdateEmployeeGoalModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="UpdateEmployeeGoalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg">
                <form id="UpdateGoalForm" class="needs-validation" novalidate method="post">
                    <div class="modal-header bg-light py-3 border-bottom border-light-subtle">
                        <h5 class="modal-title fw-bold text-dark" id="UpdateEmployeeGoalLabel">Update Employee Goal</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <input type="hidden" id="update_goal_id" />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="uEmployeeId" class="form-label fw-medium">Employee <span class="text-danger">*</span></label>
                                <select class="form-select select-employee" id="uEmployeeId" required>
                                    <option value="" disabled>Select Employee...</option>
                                </select>
                                <div class="invalid-feedback">Please select an employee.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="uGoalTypeId" class="form-label fw-medium">Goal Type <span class="text-danger">*</span></label>
                                <select class="form-select select-goaltype" id="uGoalTypeId" required>
                                    <option value="" disabled>Select Goal Type...</option>
                                </select>
                                <div class="invalid-feedback">Please select a goal type.</div>
                            </div>
                            <div class="col-12">
                                <label for="uGoalTitle" class="form-label fw-medium">Goal Title <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="uGoalTitle" required>
                                <div class="invalid-feedback">Please enter a goal title.</div>
                            </div>
                            <div class="col-12">
                                <label for="uDescription" class="form-label fw-medium">Description</label>
                                <textarea class="form-control" id="uDescription" rows="3"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label for="uStartDate" class="form-label fw-medium">Start Date</label>
                                <input type="date" class="form-control" id="uStartDate">
                            </div>
                            <div class="col-md-6">
                                <label for="uEndDate" class="form-label fw-medium">End Date</label>
                                <input type="date" class="form-control" id="uEndDate">
                            </div>
                            <div class="col-md-6">
                                <label for="uTarget" class="form-label fw-medium">Target / Key Result</label>
                                <input type="text" class="form-control" id="uTarget">
                            </div>
                            <div class="col-md-3">
                                <label for="uProgress" class="form-label fw-medium">Progress (%)</label>
                                <input type="number" class="form-control" id="uProgress" min="0" max="100">
                            </div>
                            <div class="col-md-3">
                                <label for="uStatus" class="form-label fw-medium">Status</label>
                                <select class="form-select" id="uStatus">
                                    <option value="Active">Active</option>
                                    <option value="In Progress">In Progress</option>
                                    <option value="Completed">Completed</option>
                                    <option value="Deferred">Deferred</option>
                                    <option value="Cancelled">Cancelled</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light py-2 border-top border-light-subtle">
                        <button type="button" class="btn btn-light px-3 py-1.5" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-primary px-4 py-1.5 shadow-sm">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .text-gradient {
        background: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .btn-soft-primary {
        background-color: rgba(79, 70, 229, 0.1);
        color: #4f46e5;
        border: none;
    }
    .btn-soft-primary:hover {
        background-color: #4f46e5;
        color: white;
    }
    .btn-soft-info {
        background-color: rgba(6, 182, 212, 0.1);
        color: #06b6d4;
        border: none;
    }
    .btn-soft-info:hover {
        background-color: #06b6d4;
        color: white;
    }
    .btn-soft-danger {
        background-color: rgba(239, 68, 68, 0.1);
        color: #ef4444;
        border: none;
    }
    .btn-soft-danger:hover {
        background-color: #ef4444;
        color: white;
    }
    .progress-bar-striped {
        background-image: linear-gradient(45deg,rgba(255,255,255,.15) 25%,transparent 25%,transparent 50%,rgba(255,255,255,.15) 50%,rgba(255,255,255,.15) 75%,transparent 75%,transparent);
        background-size: 1rem 1rem;
    }
</style>

<script>
    $(document).ready(function () {
        // Load dropdown options once on load
        LoadDropdownData();

        // Refresh icons when modals open
        $("#AddEmployeeGoalModal, #UpdateEmployeeGoalModal").on("shown.bs.modal", function () {
            if (window.lucide) {
                lucide.createIcons();
            }
        });

        // Reset Add Form on show
        $("#AddEmployeeGoalModal").on("show.bs.modal", function () {
            $("#AddGoalForm")[0].reset();
            $("#AddGoalForm").removeClass('was-validated');
        });

        // Submit Add Form
        $("#AddGoalForm").on("submit", function (e) {
            e.preventDefault();
            if (!this.checkValidity()) {
                e.stopPropagation();
                $(this).addClass('was-validated');
                return;
            }

            var formData = {
                EmployeeId: parseInt($("#EmployeeId").val()),
                GoalTypeId: parseInt($("#GoalTypeId").val()),
                GoalTitle: $("#GoalTitle").val(),
                Description: $("#Description").val(),
                StartDate: $("#StartDate").val() ? $("#StartDate").val() : null,
                EndDate: $("#EndDate").val() ? $("#EndDate").val() : null,
                Target: $("#Target").val(),
                Progress: parseInt($("#Progress").val()) || 0,
                Status: $("#Status").val()
            };

            $.ajax({
                url: '/Performance/SaveEmployeeGoal',
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(formData),
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert("Error: " + res.message);
                    }
                },
                error: function (xhr, status, error) {
                    alert("An error occurred: " + error);
                }
            });
        });

        // Submit Update Form
        $("#UpdateGoalForm").on("submit", function (e) {
            e.preventDefault();
            if (!this.checkValidity()) {
                e.stopPropagation();
                $(this).addClass('was-validated');
                return;
            }

            var formData = {
                EmployeeGoalId: parseInt($("#update_goal_id").val()),
                EmployeeId: parseInt($("#uEmployeeId").val()),
                GoalTypeId: parseInt($("#uGoalTypeId").val()),
                GoalTitle: $("#uGoalTitle").val(),
                Description: $("#uDescription").val(),
                StartDate: $("#uStartDate").val() ? $("#uStartDate").val() : null,
                EndDate: $("#uEndDate").val() ? $("#uEndDate").val() : null,
                Target: $("#uTarget").val(),
                Progress: parseInt($("#uProgress").val()) || 0,
                Status: $("#uStatus").val()
            };

            $.ajax({
                url: '/Performance/UpdateEmployeeGoal',
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(formData),
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert("Error: " + res.message);
                    }
                },
                error: function (xhr, status, error) {
                    alert("An error occurred: " + error);
                }
            });
        });
    });

    function LoadDropdownData() {
        // Load active employees list
        $.ajax({
            url: '/Performance/GetActiveEmployees',
            type: 'GET',
            success: function (data) {
                var selectEmp = $('.select-employee');
                // Remove existing options except first placeholder
                selectEmp.find('option:gt(0)').remove();
                if (data && data.length > 0) {
                    $.each(data, function (index, emp) {
                        var fullName = emp.FirstName + ' ' + emp.LastName;
                        selectEmp.append($('<option>', {
                            value: emp.Id,
                            text: fullName.trim() + " (" + emp.Username + ")"
                        }));
                    });
                }
            }
        });

        // Load active goal types list
        $.ajax({
            url: '/Performance/GetActiveGoalTypes',
            type: 'GET',
            success: function (data) {
                var selectGt = $('.select-goaltype');
                selectGt.find('option:gt(0)').remove();
                if (data && data.length > 0) {
                    $.each(data, function (index, gt) {
                        selectGt.append($('<option>', {
                            value: gt.GoalTypeId,
                            text: gt.GoalTypeName
                        }));
                    });
                }
            }
        });
    }

    function UpdateGoal(id) {
        $.ajax({
            url: '/Performance/GetEmployeeGoalById',
            type: 'GET',
            data: { id: id },
            success: function (data) {
                if (data) {
                    $("#update_goal_id").val(data.EmployeeGoalId);
                    $("#uEmployeeId").val(data.EmployeeId);
                    $("#uGoalTypeId").val(data.GoalTypeId);
                    $("#uGoalTitle").val(data.GoalTitle);
                    $("#uDescription").val(data.Description);
                    $("#uStartDate").val(formatJsonDate(data.StartDate));
                    $("#uEndDate").val(formatJsonDate(data.EndDate));
                    $("#uTarget").val(data.Target);
                    $("#uProgress").val(data.Progress);
                    $("#uStatus").val(data.Status);

                    $("#UpdateGoalForm").removeClass('was-validated');
                    $("#UpdateEmployeeGoalModal").modal("show");
                }
            },
            error: function (xhr, status, error) {
                alert("Failed to retrieve goal data: " + error);
            }
        });
    }

    function DeleteGoal(id) {
        if (confirm("Are you sure you want to delete this Employee Goal?")) {
            $.ajax({
                url: '/Performance/DeleteEmployeeGoal',
                type: "POST",
                data: { id: id },
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert("Error: " + res.message);
                    }
                },
                error: function (xhr, status, error) {
                    alert("An error occurred: " + error);
                }
            });
        }
    }

    function formatJsonDate(jsonDate) {
        if (!jsonDate) return "";
        var date;
        if (typeof jsonDate === 'string' && jsonDate.indexOf('/Date(') !== -1) {
            date = new Date(parseInt(jsonDate.replace(/\/Date\((\d+)\)\//, '$1')));
        } else {
            date = new Date(jsonDate);
        }
        if (isNaN(date.getTime())) return "";
        
        var month = '' + (date.getMonth() + 1);
        var day = '' + date.getDate();
        var year = date.getFullYear();

        if (month.length < 2) month = '0' + month;
        if (day.length < 2) day = '0' + day;

        return [year, month, day].join('-');
    }

    function ToggleDescription(btn) {
        var container = $(btn).closest('.desc-container');
        var shortText = container.find('.desc-short');
        var fullText = container.find('.desc-full');
        
        if (fullText.hasClass('d-none')) {
            fullText.removeClass('d-none');
            shortText.addClass('d-none');
            $(btn).text('Show Less');
        } else {
            fullText.addClass('d-none');
            shortText.removeClass('d-none');
            $(btn).text('Show More');
        }
    }
</script>

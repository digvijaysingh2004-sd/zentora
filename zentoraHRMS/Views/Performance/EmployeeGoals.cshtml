@model IEnumerable<zentoraHRMS.Models.EmployeeGoalModel>
@{
    ViewBag.Title = "Employee Goals";
}

<div class="container-fluid">
    <div class="row justify-content-center py-5">
        <div class="col-xxl-5 col-xl-7 text-center">
            <a href="@Url.Action("Index","Home")" class="badge badge-default fw-normal shadow px-2 py-1 mb-2 fst-italic fs-xxs">
                <i data-lucide="square-check" class="fs-sm me-1"></i> DashBoard
            </a>
            <h3 class="fw-bold">Employee Goals</h3>
            <p class="text-muted">Manage employee goals, set targets, track progress, and review completion status.</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-xxl-12">
            <div class="card rounded-2">
                <div class="card-header justify-content-between align-items-center d-flex">
                    <h5 class="card-title mb-0">Employee Goal Details</h5>
                    <button type="button" class="btn btn-sm btn-soft-primary" data-bs-toggle="modal" data-bs-target="#AddEmployeeGoalModal">
                        <i class="me-1" data-lucide="plus"></i> Add Employee Goal
                    </button>
                </div>

                <div class="card-body">
                    <table id="checkbox-select-data" class="table table-striped dt-responsive checkbox-select-datatable align-middle mb-0">
                        <thead class="thead-sm text-uppercase fs-xxs">
                            <tr>
                                <th class="fs-sm" style="width: 1%;">#</th>
                                <th>Title</th>
                                <th>Employee</th>
                                <th>Duration</th>
                                <th>Days</th>
                                <th>Progress</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int index = 1; }
                            @foreach (var g in Model)
                            {
                                <tr>
                                    <td class="fw-semibold text-muted text-center" style="width: 1%;">@index</td>
                                    <td>
                                        <div class="fw-semibold text-dark fs-sm mb-1">@g.GoalTitle</div>
                                        <span class="badge bg-light text-secondary border border-light-subtle rounded-pill px-2 py-0.5" style="font-size: 10px;">
                                            <i data-lucide="tag" class="fs-xxs me-1" style="width: 10px; height: 10px; vertical-align: middle;"></i>@g.GoalTypeName
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@(string.IsNullOrEmpty(g.ProfileImage) ? "/assets/images/users/user-1.jpg" : g.ProfileImage)" alt="avatar" class="rounded-circle me-2" style="width: 32px; height: 32px; object-fit: cover;" onerror="this.src='/assets/images/users/user-1.jpg';" />
                                            <div>
                                                <div class="fw-semibold text-dark fs-sm">@g.EmployeeName</div>
                                                <div class="text-muted fs-xxs">@(string.IsNullOrEmpty(g.Email) ? "no-email@example.org" : g.Email)</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fs-xs text-muted mb-1 d-flex align-items-center">
                                            <i data-lucide="calendar" class="fs-xxs me-1 text-muted" style="width: 12px; height: 12px;"></i>
                                            <span class="text-dark">@(g.StartDate.HasValue ? g.StartDate.Value.ToString("yyyy-MM-dd") : "-")</span>
                                        </div>
                                        <div class="fs-xs text-muted d-flex align-items-center">
                                            <i data-lucide="calendar" class="fs-xxs me-1 text-muted" style="width: 12px; height: 12px;"></i>
                                            <span class="text-dark">@(g.EndDate.HasValue ? g.EndDate.Value.ToString("yyyy-MM-dd") : "-")</span>
                                        </div>
                                    </td>
                                    <td>
                                        @{
                                            string daysText = "-";
                                            if (g.StartDate.HasValue && g.EndDate.HasValue)
                                            {
                                                int days = (g.EndDate.Value - g.StartDate.Value).Days;
                                                if (days >= 0)
                                                {
                                                    daysText = days + "d";
                                                }
                                            }
                                        }
                                        @if (daysText != "-")
                                        {
                                            <span class="badge rounded px-2.5 py-1" style="background-color: #f5f3ff; color: #7c3aed; border: 1px solid #ddd6fe; font-size: 11px;">@daysText</span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2" style="min-width: 130px;">
                                            <div class="progress progress-sm rounded-pill flex-grow-1" style="height: 6px; background-color: #f0f0f5; margin-bottom: 0;">
                                                @{
                                                    string progressBg = "bg-primary";
                                                    if (g.Progress >= 100) { progressBg = "bg-success"; }
                                                    else if (g.Progress >= 75) { progressBg = "bg-info"; }
                                                    else if (g.Progress >= 35) { progressBg = "bg-warning"; }
                                                    else { progressBg = "bg-danger"; }
                                                }
                                                <div class="progress-bar @progressBg" role="progressbar" style="width: @g.Progress%"></div>
                                            </div>
                                            <span class="fw-medium text-dark fs-xxs">@g.Progress%</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(g.Target))
                                        {
                                            <div class="text-muted fs-xxs mt-1 fst-italic">Target: @g.Target</div>
                                        }
                                    </td>
                                    <td>
                                        @if (g.Status == "Completed" || g.Status == "Achieved")
                                        {
                                            <span class="badge bg-success-subtle text-success">@g.Status</span>
                                        }
                                        else if (g.Status == "In Progress")
                                        {
                                            <span class="badge bg-primary-subtle text-primary">@g.Status</span>
                                        }
                                        else if (g.Status == "Deferred")
                                        {
                                            <span class="badge bg-warning-subtle text-warning">@g.Status</span>
                                        }
                                        else if (g.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger-subtle text-danger">@g.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info-subtle text-info">@g.Status</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="javascript:void(0);" onclick="ViewGoal(@g.EmployeeGoalId)" class="btn btn-sm btn-soft-primary mt-1" title="View"><i data-lucide="eye"></i></a>
                                        <a href="javascript:void(0);" onclick="UpdateGoal(@g.EmployeeGoalId)" class="btn btn-sm btn-soft-info mt-1" title="Update"><i data-lucide="square-pen"></i></a>
                                        <a href="javascript:void(0);" onclick="DeleteGoal(@g.EmployeeGoalId)" class="btn btn-sm btn-soft-danger mt-1" title="Delete"><i data-lucide="trash-2"></i></a>
                                    </td>
                                </tr>
                                index++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Employee Goal Modal -->
    <div id="AddEmployeeGoalModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <form id="AddGoalForm" class="needs-validation" novalidate method="post">
                    <div class="modal-header">
                        <h4 class="modal-title">Add Employee Goal</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="EmployeeId" class="form-label">Employee <span class="text-danger">*</span></label>
                            <select class="form-select select-employee" id="EmployeeId" data-choices required>
                                <option value="">Select Employee</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="GoalTypeId" class="form-label">Goal Type <span class="text-danger">*</span></label>
                            <select class="form-select select-goaltype" id="GoalTypeId" data-choices required>
                                <option value="">Select Goal Type</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="GoalTitle" class="form-label">Goal Title <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="GoalTitle" required placeholder="Enter goal title">
                        </div>
                        <div class="mb-3">
                            <label for="Description" class="form-label">Description</label>
                            <textarea class="form-control" id="Description" rows="3" placeholder="Enter description of goal"></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="StartDate" class="form-label">Start Date</label>
                            <input type="date" class="form-control" id="StartDate">
                        </div>
                        <div class="mb-3">
                            <label for="EndDate" class="form-label">End Date</label>
                            <input type="date" class="form-control" id="EndDate">
                        </div>
                        <div class="mb-3">
                            <label for="Target" class="form-label">Target</label>
                            <input type="text" class="form-control" id="Target" placeholder="Enter target metrics">
                        </div>
                        <div class="mb-3">
                            <label for="Progress" class="form-label">Progress (%)</label>
                            <input type="number" class="form-control" id="Progress" min="0" max="100" value="0">
                        </div>
                        <div class="mb-3">
                            <label for="Status" class="form-label">Status</label>
                            <select class="form-select" id="Status" data-choices>
                                <option value="Active" selected>Active</option>
                                <option value="In Progress">In Progress</option>
                                <option value="Completed">Completed</option>
                                <option value="Deferred">Deferred</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-soft-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Update Employee Goal Modal -->
    <div id="UpdateEmployeeGoalModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <form id="UpdateGoalForm" class="needs-validation" novalidate method="post">
                    <div class="modal-header">
                        <h4 class="modal-title">Update Employee Goal</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="update_goal_id" />
                        <div class="mb-3">
                            <label for="uEmployeeId" class="form-label">Employee <span class="text-danger">*</span></label>
                            <select class="form-select select-employee" id="uEmployeeId" data-choices required>
                                <option value="">Select Employee</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="uGoalTypeId" class="form-label">Goal Type <span class="text-danger">*</span></label>
                            <select class="form-select select-goaltype" id="uGoalTypeId" data-choices required>
                                <option value="">Select Goal Type</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="uGoalTitle" class="form-label">Goal Title <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="uGoalTitle" required>
                        </div>
                        <div class="mb-3">
                            <label for="uDescription" class="form-label">Description</label>
                            <textarea class="form-control" id="uDescription" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="uStartDate" class="form-label">Start Date</label>
                            <input type="date" class="form-control" id="uStartDate">
                        </div>
                        <div class="mb-3">
                            <label for="uEndDate" class="form-label">End Date</label>
                            <input type="date" class="form-control" id="uEndDate">
                        </div>
                        <div class="mb-3">
                            <label for="uTarget" class="form-label">Target</label>
                            <input type="text" class="form-control" id="uTarget">
                        </div>
                        <div class="mb-3">
                            <label for="uProgress" class="form-label">Progress (%)</label>
                            <input type="number" class="form-control" id="uProgress" min="0" max="100">
                        </div>
                        <div class="mb-3">
                            <label for="uStatus" class="form-label">Status</label>
                            <select class="form-select" id="uStatus" data-choices>
                                <option value="Active">Active</option>
                                <option value="In Progress">In Progress</option>
                                <option value="Completed">Completed</option>
                                <option value="Deferred">Deferred</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-soft-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- View Employee Goal Modal -->
    <div id="ViewEmployeeGoalModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Employee Goal Details</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="text-center mb-4">
                        <img id="vAvatar" src="/assets/images/users/user-1.jpg" alt="avatar" class="rounded-circle mb-2" style="width: 70px; height: 70px; object-fit: cover; border: 3px solid #f5f3ff;" onerror="this.src='/assets/images/users/user-1.jpg';" />
                        <h5 class="fw-bold text-dark mb-0" id="vEmployeeName">-</h5>
                        <p class="text-muted fs-xs" id="vEmployeeEmail">-</p>
                    </div>
                    
                    <div class="mb-3">
                        <span class="fs-xxs text-uppercase text-muted fw-bold d-block mb-1">Goal Title</span>
                        <div class="fw-semibold text-dark fs-sm" id="vGoalTitle">-</div>
                    </div>
                    
                    <div class="mb-3">
                        <span class="fs-xxs text-uppercase text-muted fw-bold d-block mb-1">Goal Type</span>
                        <span class="badge bg-light text-secondary border border-light-subtle rounded-pill px-2.5 py-1" id="vGoalTypeName">-</span>
                    </div>
                    
                    <div class="mb-3">
                        <span class="fs-xxs text-uppercase text-muted fw-bold d-block mb-1">Description</span>
                        <div class="fs-sm text-dark bg-light p-2.5 rounded border border-light-subtle" id="vDescription" style="white-space: pre-wrap; max-height: 150px; overflow-y: auto;">-</div>
                    </div>
                    
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <span class="fs-xxs text-uppercase text-muted fw-bold d-block mb-1">Start Date</span>
                            <div class="fs-sm text-dark fw-medium" id="vStartDate">-</div>
                        </div>
                        <div class="col-6">
                            <span class="fs-xxs text-uppercase text-muted fw-bold d-block mb-1">End Date</span>
                            <div class="fs-sm text-dark fw-medium" id="vEndDate">-</div>
                        </div>
                    </div>
                    
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <span class="fs-xxs text-uppercase text-muted fw-bold d-block mb-1">Target</span>
                            <div class="fs-sm text-dark fw-medium" id="vTarget">-</div>
                        </div>
                        <div class="col-6">
                            <span class="fs-xxs text-uppercase text-muted fw-bold d-block mb-1">Progress</span>
                            <div class="fs-sm text-dark fw-bold" id="vProgress">-</div>
                        </div>
                    </div>
                    
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <span class="fs-xxs text-uppercase text-muted fw-bold d-block mb-1">Status</span>
                            <span class="badge px-2.5 py-1 mt-0.5" id="vStatus">-</span>
                        </div>
                        <div class="col-6">
                            <span class="fs-xxs text-uppercase text-muted fw-bold d-block mb-1">System Addon</span>
                            <span class="badge bg-light text-dark border px-2.5 py-1 mt-0.5" id="vSystemAddon">-</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Load dropdown options once on load
        LoadDropdownData();

        // Refresh icons when modals open
        $("#AddEmployeeGoalModal, #UpdateEmployeeGoalModal, #ViewEmployeeGoalModal").on("shown.bs.modal", function () {
            if (window.lucide) {
                lucide.createIcons();
            }
        });

        // Reset Add Form on show
        $("#AddEmployeeGoalModal").on("show.bs.modal", function () {
            $("#AddGoalForm")[0].reset();
            $("#AddGoalForm").removeClass('was-validated');

            var elEmp = document.getElementById("EmployeeId");
            if (elEmp && elEmp.choicesInstance) {
                elEmp.choicesInstance.setChoiceByValue("");
            }
            var elGt = document.getElementById("GoalTypeId");
            if (elGt && elGt.choicesInstance) {
                elGt.choicesInstance.setChoiceByValue("");
            }
            var elStatus = document.getElementById("Status");
            if (elStatus && elStatus.choicesInstance) {
                elStatus.choicesInstance.setChoiceByValue("Active");
            }
        });

        // Submit Add Form
        $("#AddGoalForm").on("submit", function (e) {
            e.preventDefault();
            if (!this.checkValidity()) {
                e.stopPropagation();
                $(this).addClass('was-validated');
                return;
            }

            var formData = {
                EmployeeId: parseInt($("#EmployeeId").val()),
                GoalTypeId: parseInt($("#GoalTypeId").val()),
                GoalTitle: $("#GoalTitle").val(),
                Description: $("#Description").val(),
                StartDate: $("#StartDate").val() ? $("#StartDate").val() : null,
                EndDate: $("#EndDate").val() ? $("#EndDate").val() : null,
                Target: $("#Target").val(),
                Progress: parseInt($("#Progress").val()) || 0,
                Status: $("#Status").val()
            };

            $.ajax({
                url: '/Performance/SaveEmployeeGoal',
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(formData),
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert("Error: " + res.message);
                    }
                },
                error: function (xhr, status, error) {
                    alert("An error occurred: " + error);
                }
            });
        });

        // Submit Update Form
        $("#UpdateGoalForm").on("submit", function (e) {
            e.preventDefault();
            if (!this.checkValidity()) {
                e.stopPropagation();
                $(this).addClass('was-validated');
                return;
            }

            var formData = {
                EmployeeGoalId: parseInt($("#update_goal_id").val()),
                EmployeeId: parseInt($("#uEmployeeId").val()),
                GoalTypeId: parseInt($("#uGoalTypeId").val()),
                GoalTitle: $("#uGoalTitle").val(),
                Description: $("#uDescription").val(),
                StartDate: $("#uStartDate").val() ? $("#uStartDate").val() : null,
                EndDate: $("#uEndDate").val() ? $("#uEndDate").val() : null,
                Target: $("#uTarget").val(),
                Progress: parseInt($("#uProgress").val()) || 0,
                Status: $("#uStatus").val()
            };

            $.ajax({
                url: '/Performance/UpdateEmployeeGoal',
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(formData),
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert("Error: " + res.message);
                    }
                },
                error: function (xhr, status, error) {
                    alert("An error occurred: " + error);
                }
            });
        });
    });

    function LoadDropdownData() {
        // Load active employees list
        $.ajax({
            url: '/Performance/GetActiveEmployees',
            type: 'GET',
            success: function (data) {
                var selectEmpAdd = $('#EmployeeId');
                var selectEmpEdit = $('#uEmployeeId');
                
                var s = '<option value="">Select Employee</option>';
                if (data && data.length > 0) {
                    $.each(data, function (index, emp) {
                        var fullName = emp.FirstName + ' ' + emp.LastName;
                        var textVal = fullName.trim();
                        if (emp.Username && emp.Username !== "null" && emp.Username.trim() !== "") {
                            textVal += " (" + emp.Username.trim() + ")";
                        }
                        s += '<option value="' + emp.Id + '">' + textVal + '</option>';
                    });
                }
                selectEmpAdd.html(s);
                selectEmpEdit.html(s);
            }
        });

        // Load active goal types list
        $.ajax({
            url: '/Performance/GetActiveGoalTypes',
            type: 'GET',
            success: function (data) {
                var selectGt = $('.select-goaltype');
                var s = '<option value="">Select Goal Type</option>';
                if (data && data.length > 0) {
                    $.each(data, function (index, gt) {
                        s += '<option value="' + gt.GoalTypeId + '">' + gt.GoalTypeName + '</option>';
                    });
                }
                selectGt.html(s);
            }
        });
    }

    function UpdateGoal(id) {
        $.ajax({
            url: '/Performance/GetEmployeeGoalById',
            type: 'GET',
            data: { id: id },
            success: function (data) {
                if (data) {
                    $("#update_goal_id").val(data.EmployeeGoalId);
                    
                    var elEmp = document.getElementById("uEmployeeId");
                    if (elEmp && elEmp.choicesInstance) {
                        elEmp.choicesInstance.setChoiceByValue(data.EmployeeId.toString());
                    } else {
                        $("#uEmployeeId").val(data.EmployeeId);
                    }

                    var elGt = document.getElementById("uGoalTypeId");
                    if (elGt && elGt.choicesInstance) {
                        elGt.choicesInstance.setChoiceByValue(data.GoalTypeId.toString());
                    } else {
                        $("#uGoalTypeId").val(data.GoalTypeId);
                    }

                    $("#uGoalTitle").val(data.GoalTitle);
                    $("#uDescription").val(data.Description);
                    $("#uStartDate").val(formatJsonDate(data.StartDate));
                    $("#uEndDate").val(formatJsonDate(data.EndDate));
                    $("#uTarget").val(data.Target);
                    $("#uProgress").val(data.Progress);
                    
                    var elStatus = document.getElementById("uStatus");
                    if (elStatus && elStatus.choicesInstance) {
                        elStatus.choicesInstance.setChoiceByValue(data.Status);
                    } else {
                        $("#uStatus").val(data.Status);
                    }

                    $("#UpdateGoalForm").removeClass('was-validated');
                    $("#UpdateEmployeeGoalModal").modal("show");
                }
            },
            error: function (xhr, status, error) {
                alert("Failed to retrieve goal data: " + error);
            }
        });
    }

    function ViewGoal(id) {
        $.ajax({
            url: '/Performance/GetEmployeeGoalById',
            type: 'GET',
            data: { id: id },
            success: function (data) {
                if (data) {
                    $("#vEmployeeName").text(data.EmployeeName);
                    $("#vEmployeeEmail").text(data.Email || "no-email@example.org");
                    $("#vAvatar").attr("src", data.ProfileImage || "/assets/images/users/user-1.jpg");
                    $("#vGoalTitle").text(data.GoalTitle);
                    $("#vGoalTypeName").text(data.GoalTypeName);
                    $("#vDescription").text(data.Description || "-");
                    $("#vStartDate").text(data.StartDate ? displayDate(data.StartDate) : "-");
                    $("#vEndDate").text(data.EndDate ? displayDate(data.EndDate) : "-");
                    $("#vTarget").text(data.Target || "-");
                    $("#vProgress").text(data.Progress + "%");
                    
                    var statusEl = $("#vStatus");
                    statusEl.removeClass().addClass("badge");
                    if (data.Status === "Completed" || data.Status === "Achieved") {
                        statusEl.addClass("bg-success-subtle text-success");
                    } else if (data.Status === "In Progress") {
                        statusEl.addClass("bg-primary-subtle text-primary");
                    } else if (data.Status === "Deferred") {
                        statusEl.addClass("bg-warning-subtle text-warning");
                    } else if (data.Status === "Cancelled") {
                        statusEl.addClass("bg-danger-subtle text-danger");
                    } else {
                        statusEl.addClass("bg-info-subtle text-info");
                    }
                    statusEl.text(data.Status);

                    var addonEl = $("#vSystemAddon");
                    addonEl.text(data.SystemAddon ? "Yes" : "No");

                    $("#ViewEmployeeGoalModal").modal("show");
                }
            },
            error: function (xhr, status, error) {
                alert("Failed to retrieve goal data: " + error);
            }
        });
    }

    function DeleteGoal(id) {
        if (confirm("Are you sure you want to delete this Employee Goal?")) {
            $.ajax({
                url: '/Performance/DeleteEmployeeGoal',
                type: "POST",
                data: { id: id },
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert("Error: " + res.message);
                    }
                },
                error: function (xhr, status, error) {
                    alert("An error occurred: " + error);
                }
            });
        }
    }

    function formatJsonDate(jsonDate) {
        if (!jsonDate) return "";
        var date;
        if (typeof jsonDate === 'string' && jsonDate.indexOf('/Date(') !== -1) {
            date = new Date(parseInt(jsonDate.replace(/\/Date\((\d+)\)\//, '$1')));
        } else {
            date = new Date(jsonDate);
        }
        if (isNaN(date.getTime())) return "";
        
        var month = '' + (date.getMonth() + 1);
        var day = '' + date.getDate();
        var year = date.getFullYear();

        if (month.length < 2) month = '0' + month;
        if (day.length < 2) day = '0' + day;

        return [year, month, day].join('-');
    }

    function displayDate(jsonDate) {
        if (!jsonDate) return "-";
        var date;
        if (typeof jsonDate === 'string' && jsonDate.indexOf('/Date(') !== -1) {
            date = new Date(parseInt(jsonDate.replace(/\/Date\((\d+)\)\//, '$1')));
        } else {
            date = new Date(jsonDate);
        }
        if (isNaN(date.getTime())) return "-";
        return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
    }

    function ToggleDescription(btn) {
        var container = $(btn).closest('.desc-container');
        var shortText = container.find('.desc-short');
        var fullText = container.find('.desc-full');
        
        if (fullText.hasClass('d-none')) {
            fullText.removeClass('d-none');
            shortText.addClass('d-none');
            $(btn).text('Show Less');
        } else {
            fullText.addClass('d-none');
            shortText.removeClass('d-none');
            $(btn).text('Show More');
        }
    }
</script>

@model IEnumerable<zentoraHRMS.Models.IndicatorCategoryModel>
@{
    ViewBag.Title = "Indicator Categories";
}

<div class="container-fluid">
    <div class="row justify-content-center py-5">
        <div class="col-xxl-5 col-xl-7 text-center">
            <a href="@Url.Action("Index","Home")" class="badge badge-default fw-normal shadow px-2 py-1 mb-2 fst-italic fs-xxs">
                <i data-lucide="square-check" class="fs-sm me-1"></i> DashBoard
            </a>
            <h3 class="fw-bold">Indicator Categories</h3>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-xxl-12">
            <div class="card rounded-2">
                <div class="card-header justify-content-between">
                    <h5 class="card-title">Category Details</h5>
                    <button type="button" class="btn btn-sm btn-soft-primary" data-bs-toggle="modal" data-bs-target="#AddCategory">
                        <i class="me-1" data-lucide="plus"></i> Add Category
                    </button>
                </div>

                <div class="card-body">
                    <table id="checkbox-select-data" class="table table-striped dt-responsive checkbox-select-datatable align-middle mb-0">
                        <thead class="thead-sm text-uppercase fs-xxs">
                            <tr>
                                <th class="fs-sm" style="width: 1%;"></th>
                                <th>Category ID</th>
                                <th>Category Name</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model)
                            {
                                <tr>
                                    <td class="fs-sm" style="width: 1%;"></td>
                                    <td>@c.IndicatorCategoryId</td>
                                    <td>@c.CategoryName</td>
                                    <td>@c.Description</td>
                                    <td>
                                        @if (c.IsActive) { <span class="badge bg-success-subtle text-success">Active</span> }
                                        else { <span class="badge bg-danger-subtle text-danger">Inactive</span> }
                                    </td>
                                    <td>
                                        <a onclick="UpdateCategory(@c.IndicatorCategoryId)" class="btn btn-sm btn-soft-info mt-1" title="Update"><i data-lucide="square-pen"></i></a>
                                        <a onclick="DeleteCategory(@c.IndicatorCategoryId)" class="btn btn-sm btn-soft-danger mt-1" title="Delete"><i data-lucide="trash-2"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- AddCategory Modal -->
    <div id="AddCategory" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="CategoryForm" class="needs-validation" novalidate method="post">
                    <div class="modal-header">
                        <h4 class="modal-title">Add Indicator Category</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="CategoryName" class="form-label">Category Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="CategoryName" required>
                        </div>
                        <div class="mb-3">
                            <label for="Description" class="form-label">Description</label>
                            <textarea class="form-control" id="Description" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="IsActive" class="form-label">Status</label>
                            <select class="form-select" id="IsActive" data-choices>
                                <option value="true" selected>Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-soft-primary">Save changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- UpdateCategory Modal -->
    <div id="UpdateCategoryModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="UpdateCategoryForm" class="needs-validation" novalidate method="post">
                    <div class="modal-header">
                        <h4 class="modal-title">Update Indicator Category</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="update_id" />
                        <div class="mb-3">
                            <label for="uCategoryName" class="form-label">Category Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="uCategoryName" required>
                        </div>
                        <div class="mb-3">
                            <label for="uDescription" class="form-label">Description</label>
                            <textarea class="form-control" id="uDescription" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="uIsActive" class="form-label">Status</label>
                            <select class="form-select" id="uIsActive" data-choices>
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-soft-primary">Save changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $("#AddCategory").on("show.bs.modal", function () {
            $("#CategoryForm")[0].reset();
            var elStatus = document.getElementById("IsActive");
            if (elStatus && elStatus.choicesInstance) {
                elStatus.choicesInstance.setChoiceByValue("true");
            }
        });

        $("#CategoryForm").on("submit", function (e) {
            e.preventDefault();
            var formData = {
                CategoryName: $("#CategoryName").val(),
                Description: $("#Description").val(),
                IsActive: $("#IsActive").val() === "true"
            };
            $.ajax({
                url: '/Performance/SaveIndicatorCategory',
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(formData),
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert("Error: " + res.message);
                    }
                }
            });
        });

        $("#UpdateCategoryForm").on("submit", function (e) {
            e.preventDefault();
            var formData = {
                IndicatorCategoryId: $("#update_id").val(),
                CategoryName: $("#uCategoryName").val(),
                Description: $("#uDescription").val(),
                IsActive: $("#uIsActive").val() === "true"
            };
            $.ajax({
                url: '/Performance/UpdateIndicatorCategory',
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(formData),
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert("Error: " + res.message);
                    }
                }
            });
        });
    });

    function UpdateCategory(id) {
        $.ajax({
            url: '/Performance/GetIndicatorCategoryById',
            type: 'GET',
            data: { id: id },
            success: function (data) {
                if (data) {
                    $("#update_id").val(data.IndicatorCategoryId);
                    $("#uCategoryName").val(data.CategoryName);
                    $("#uDescription").val(data.Description);
                    
                    var elStatus = document.getElementById("uIsActive");
                    if (elStatus && elStatus.choicesInstance) {
                        elStatus.choicesInstance.setChoiceByValue(data.IsActive.toString());
                    } else {
                        $("#uIsActive").val(data.IsActive.toString());
                    }
                    
                    $("#UpdateCategoryModal").modal("show");
                }
            }
        });
    }

    function DeleteCategory(id) {
        if (confirm("Are you sure you want to delete this indicator category? This will delete all indicators under this category.")) {
            $.ajax({
                url: '/Performance/DeleteIndicatorCategory',
                type: "POST",
                data: { id: id },
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert("Error: " + res.message);
                    }
                }
            });
        }
    }
</script>

@model IEnumerable<zentoraHRMS.Models.EmployeeReviewModel>
@{
    ViewBag.Title = "Employee Reviews";
    bool isAdmin = ViewBag.IsAdmin ?? false;
}

<style>
    /* Prevent Choices.js select dropdowns from being cut off or layered behind the modal footer */
    .choices.is-open {
        z-index: 1050 !important;
    }
    .choices__list--dropdown {
        z-index: 9999 !important;
    }

    .rating-badge {
        font-weight: 600;
        background-color: #8b5cf6 !important;
        color: #ffffff !important;
        font-size: 11px;
    }

    [data-bs-theme=dark] .rating-badge {
        background-color: rgba(139, 92, 246, 0.2) !important;
        color: #a78bfa !important;
    }

    /* Style updates to support transparent backgrounds and correct down line visibility */
    .nav-tabs .nav-link {
        background: transparent !important;
        border: none !important;
        color: #6c757d !important;
    }
    .nav-tabs .nav-link.active {
        color: #8b5cf6 !important;
        background: transparent !important;
        border-bottom: 2px solid #8b5cf6 !important;
        font-weight: 600;
    }
    .nav-tabs {
        border-bottom: none !important;
    }
</style>

<div class="container-fluid">
    <!-- Standard Dashboard Header -->
    <div class="row justify-content-center py-5">
        <div class="col-xxl-5 col-xl-7 text-center">
            <a href="@Url.Action("Index","Home")" class="badge badge-default fw-normal shadow px-2 py-1 mb-2 fst-italic fs-xxs">
                <i data-lucide="square-check" class="fs-sm me-1"></i> DashBoard
            </a>
            <h3 class="fw-bold">Employee Reviews</h3>
            <p class="text-muted">Manage employee performance reviews, schedule milestones, rate indicators and track comments.</p>
        </div>
    </div>

    <!-- Main Table & Card Section matching current design patterns -->
    <div class="row justify-content-center">
        <div class="col-xxl-12">
            <div class="card rounded-2">
                <div class="card-header justify-content-between align-items-center d-flex">
                    <h5 class="card-title mb-0">Employee Review Details</h5>
                    @if (isAdmin)
                    {
                        <button type="button" class="btn btn-sm btn-soft-primary" onclick="OpenScheduleModal()">
                            <i class="me-1" data-lucide="plus"></i> Schedule Review
                        </button>
                    }
                </div>

                <!-- Custom Filter Panel aligned with client grids (transparent background) -->
                <div class="p-3 bg-transparent border-bottom border-light-subtle">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-3 col-sm-6">
                            <select id="filterReviewCycle" class="form-select form-select-sm">
                                <option value="">All Review Cycle</option>
                                @foreach (var cycle in Model.Select(r => r.ReviewCycleName).Distinct())
                                {
                                    <option value="@cycle">@cycle</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 col-sm-4">
                            <input type="date" id="filterStartDate" class="form-control form-control-sm" title="Start Date">
                        </div>
                        <div class="col-md-3 col-sm-4">
                            <input type="date" id="filterEndDate" class="form-control form-control-sm" title="End Date">
                        </div>
                        <div class="col-md-3 col-sm-4">
                            <button type="button" class="btn btn-sm btn-outline-secondary w-100 d-inline-flex align-items-center justify-content-center" onclick="ClearFilters()">
                                <i data-lucide="sliders-horizontal" class="fs-xxs me-1" style="width: 12px; height: 12px;"></i> Clear Filters
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Dynamic status tabs matching dashboard panels (transparent background) -->
                <div class="bg-transparent border-bottom border-light-subtle px-3">
                    <ul class="nav nav-tabs border-bottom-0 fs-xs" id="reviewTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active px-3 py-2 border-0 rounded-0 fw-medium" type="button" onclick="SetCurrentTab('All')">
                                All <span class="badge bg-secondary-subtle text-secondary ms-1 rounded-pill" id="countAll">0</span>
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link px-3 py-2 border-0 rounded-0 fw-medium" type="button" onclick="SetCurrentTab('Scheduled')">
                                Scheduled <span class="badge bg-info-subtle text-info ms-1 rounded-pill" id="countScheduled">0</span>
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link px-3 py-2 border-0 rounded-0 fw-medium" type="button" onclick="SetCurrentTab('In Progress')">
                                In Progress <span class="badge bg-warning-subtle text-warning ms-1 rounded-pill" id="countInProgress">0</span>
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link px-3 py-2 border-0 rounded-0 fw-medium" type="button" onclick="SetCurrentTab('Completed')">
                                Completed <span class="badge bg-success-subtle text-success ms-1 rounded-pill" id="countCompleted">0</span>
                            </button>
                        </li>
                    </ul>
                </div>

                <div class="card-body">
                    <table id="checkbox-select-data" class="table table-striped dt-responsive checkbox-select-datatable align-middle mb-0">
                        <thead class="thead-sm text-uppercase fs-xxs">
                            <tr>
                                <th class="fs-sm text-center" style="width: 1%;">#</th>
                                <th>Employee</th>
                                <th>Reviewer</th>
                                <th>Review Cycle</th>
                                <th>Review Date</th>
                                <th>Rating</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int index = 1; }
                            @foreach (var r in Model)
                            {
                                <tr>
                                    <td class="fw-semibold text-muted text-center" style="width: 1%;">@index</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(r.EmployeeImage))
                                            {
                                                <img src="@r.EmployeeImage" alt="avatar" class="rounded-circle me-2" style="width: 32px; height: 32px; object-fit: cover;" onerror="this.onerror=null; this.src='/assets/images/users/avatar-1.jpg';" />
                                            }
                                            else
                                            {
                                                var empInit = "";
                                                if (!string.IsNullOrEmpty(r.EmployeeName))
                                                {
                                                    var parts = r.EmployeeName.Trim().Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
                                                    if (parts.Length > 0)
                                                    {
                                                        empInit += parts[0][0];
                                                        if (parts.Length > 1)
                                                        {
                                                            empInit += parts[parts.Length - 1][0];
                                                        }
                                                    }
                                                }
                                                if (string.IsNullOrEmpty(empInit)) { empInit = "EE"; }
                                                empInit = empInit.ToUpper();
                                                <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center shadow-sm fw-semibold me-2" style="width: 32px; height: 32px; font-size: 10px; min-width: 32px;">
                                                    @empInit
                                                </div>
                                            }
                                            <div>
                                                <div class="fw-semibold text-dark fs-sm">@r.EmployeeName</div>
                                                <div class="text-muted fs-xxs">@r.EmployeeEmail</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(r.ReviewerImage))
                                            {
                                                <img src="@r.ReviewerImage" alt="avatar" class="rounded-circle me-2" style="width: 32px; height: 32px; object-fit: cover;" onerror="this.onerror=null; this.src='/assets/images/users/avatar-2.jpg';" />
                                            }
                                            else
                                            {
                                                var revInit = "";
                                                if (!string.IsNullOrEmpty(r.ReviewerName))
                                                {
                                                    var parts = r.ReviewerName.Trim().Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
                                                    if (parts.Length > 0)
                                                    {
                                                        revInit += parts[0][0];
                                                        if (parts.Length > 1)
                                                        {
                                                            revInit += parts[parts.Length - 1][0];
                                                        }
                                                    }
                                                }
                                                if (string.IsNullOrEmpty(revInit)) { revInit = "RR"; }
                                                revInit = revInit.ToUpper();
                                                <div class="rounded-circle bg-info-subtle text-info d-flex align-items-center justify-content-center shadow-sm fw-semibold me-2" style="width: 32px; height: 32px; font-size: 10px; min-width: 32px;">
                                                    @revInit
                                                </div>
                                            }
                                            <div>
                                                <div class="fw-semibold text-dark fs-sm">@r.ReviewerName</div>
                                                <div class="text-muted fs-xxs">@r.ReviewerEmail</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="fw-medium text-dark fs-sm">@r.ReviewCycleName</td>
                                    <td>
                                        <span class="text-dark fs-sm">@r.ReviewDate.ToString("yyyy-MM-dd")</span>
                                    </td>
                                    <td class="fw-bold text-primary fs-sm">
                                        @(r.Rating.HasValue ? r.Rating.Value.ToString("0.0") : "-")
                                    </td>
                                    <td>
                                        @if (r.Status == "Completed")
                                        {
                                            <span class="badge bg-success-subtle text-success">Completed</span>
                                        }
                                        else if (r.Status == "In Progress")
                                        {
                                            <span class="badge bg-warning-subtle text-warning">In Progress</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info-subtle text-info">Scheduled</span>
                                        }
                                    </td>
                                    <td>
                                        @if (r.Status == "Completed")
                                        {
                                            <a href="javascript:void(0);" onclick="OpenViewReviewModal(@r.ReviewId)" class="btn btn-sm btn-soft-primary mt-1" title="View Review Details"><i data-lucide="eye"></i></a>
                                        }
                                        else
                                        {
                                            <a href="javascript:void(0);" onclick="OpenConductReviewModal(@r.ReviewId, @r.EmployeeId)" class="btn btn-sm btn-soft-success mt-1" title="Conduct Performance Review"><i data-lucide="clipboard-signature"></i></a>
                                        }
                                        @if (isAdmin)
                                        {
                                            <a href="javascript:void(0);" onclick="OpenEditReviewModal(@r.ReviewId)" class="btn btn-sm btn-soft-info mt-1" title="Edit Schedule"><i data-lucide="square-pen"></i></a>
                                            <a href="javascript:void(0);" onclick="ResetReview(@r.ReviewId)" class="btn btn-sm btn-soft-warning mt-1" title="Reset Review Ratings"><i data-lucide="refresh-cw"></i></a>
                                            <a href="javascript:void(0);" onclick="DeleteReview(@r.ReviewId)" class="btn btn-sm btn-soft-danger mt-1" title="Delete Schedule"><i data-lucide="trash-2"></i></a>
                                        }
                                    </td>
                                </tr>
                                index++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==============================================
     MODALS
     ============================================== -->

<!-- 1. Schedule / Edit Review Modal -->
<div id="ScheduleReviewModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form id="ScheduleReviewForm" class="modal-content border border-light-subtle" style="border-radius: 6px; box-shadow: 0 5px 15px rgba(0,0,0,0.08);" novalidate method="post" onsubmit="SubmitScheduleReview(event)">
            <div class="modal-header">
                <h4 class="modal-title" id="ScheduleReviewModalLabel">Schedule Performance Review</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="sch_review_id" value="0">
                
                <div class="mb-3">
                    <label for="sch_employee_id" class="form-label">Employee <span class="text-danger">*</span></label>
                    <select class="form-select" id="sch_employee_id" data-choices data-choices-search-false required>
                        <option value="">Select Employee</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="sch_reviewer_id" class="form-label">Reviewer <span class="text-danger">*</span></label>
                    <select class="form-select" id="sch_reviewer_id" data-choices data-choices-search-false required>
                        <option value="">Select Reviewer</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="sch_cycle_id" class="form-label">Review Cycle <span class="text-danger">*</span></label>
                    <select class="form-select" id="sch_cycle_id" data-choices data-choices-search-false required>
                        <option value="">Select Review Cycle</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="sch_date" class="form-label">Review Date <span class="text-danger">*</span></label>
                    <input type="date" class="form-control" id="sch_date" required>
                </div>

                <div class="mb-3">
                    <label for="sch_status" class="form-label">Status <span class="text-danger">*</span></label>
                    <select class="form-select" id="sch_status" data-choices data-choices-search-false required>
                        <option value="Scheduled" selected>Scheduled</option>
                        <option value="In Progress">In Progress</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-soft-primary" id="btnScheduleSubmit">Schedule Review</button>
            </div>
        </form>
    </div>
</div>

<!-- 2. Conduct Review Modal -->
<div id="ConductReviewModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <form id="ConductReviewForm" class="modal-content border border-light-subtle" style="border-radius: 6px; box-shadow: 0 5px 15px rgba(0,0,0,0.08);" novalidate method="post" onsubmit="SubmitConductedReview(event)">
            <div class="modal-header">
                <h4 class="modal-title">Conduct Performance Review</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Info Header card -->
                <div class="card border border-light-subtle bg-light mb-4 shadow-none">
                    <div class="card-body p-3">
                        <div class="row g-3 fs-xs text-dark">
                            <div class="col-md-3 col-sm-6">
                                <span class="text-muted d-block font-size-10 text-uppercase fw-semibold mb-1">Employee</span>
                                <span class="fw-bold" id="cond_employee_name">-</span>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <span class="text-muted d-block font-size-10 text-uppercase fw-semibold mb-1">Reviewer</span>
                                <span class="fw-bold" id="cond_reviewer_name">-</span>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <span class="text-muted d-block font-size-10 text-uppercase fw-semibold mb-1">Review Cycle</span>
                                <span class="fw-bold" id="cond_cycle_name">-</span>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <span class="text-muted d-block font-size-10 text-uppercase fw-semibold mb-1">Review Date</span>
                                <span class="fw-bold" id="cond_date">-</span>
                            </div>
                        </div>
                    </div>
                </div>

                <h5 class="fw-bold mb-3 fs-sm border-bottom pb-2">Indicators Performance Rating</h5>

                <div id="conductQuestionsContainer">
                    <!-- Dynamic Questions Categories -->
                </div>

                <!-- Overall Comments card -->
                <div class="card border border-light-subtle shadow-none mb-2 mt-4">
                    <div class="card-header bg-light py-2">
                        <h6 class="fw-semibold text-dark mb-0 fs-xs">Overall Review Comments</h6>
                    </div>
                    <div class="card-body">
                        <textarea class="form-control" id="cond_overall_comments" rows="3" placeholder="Enter overall remarks and goals settings recommendations..."></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-soft-primary">Submit Review</button>
            </div>
        </form>
    </div>
</div>

<!-- 3. View Review Details Modal (Read-Only) -->
<div id="ViewReviewModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content border border-light-subtle" style="border-radius: 6px; box-shadow: 0 5px 15px rgba(0,0,0,0.08);">
            <div class="modal-header">
                <h4 class="modal-title">View Performance Review</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Info Header card -->
                <div class="card border border-light-subtle bg-light mb-4 shadow-none">
                    <div class="card-body p-3">
                        <div class="row g-3 align-items-center">
                            <div class="col-md-9">
                                <div class="row g-3 fs-xs text-dark">
                                    <div class="col-md-4 col-sm-6">
                                        <span class="text-muted d-block font-size-10 text-uppercase fw-semibold mb-1">Employee</span>
                                        <span class="fw-bold" id="view_employee_name">-</span>
                                    </div>
                                    <div class="col-md-4 col-sm-6">
                                        <span class="text-muted d-block font-size-10 text-uppercase fw-semibold mb-1">Reviewer</span>
                                        <span class="fw-bold" id="view_reviewer_name">-</span>
                                    </div>
                                    <div class="col-md-4 col-sm-6">
                                        <span class="text-muted d-block font-size-10 text-uppercase fw-semibold mb-1">Review Cycle</span>
                                        <span class="fw-bold" id="view_cycle_name">-</span>
                                    </div>
                                    <div class="col-md-4 col-sm-6">
                                        <span class="text-muted d-block font-size-10 text-uppercase fw-semibold mb-1">Review Date</span>
                                        <span class="fw-bold" id="view_date">-</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 text-center border-start border-light-subtle">
                                <span class="text-muted d-block font-size-10 text-uppercase fw-semibold mb-1">Overall Rating</span>
                                <h3 class="fw-bold text-primary mb-0" id="view_overall_rating">-</h3>
                                 <div class="d-inline-block text-center mt-1" id="view_rating_stars_container">
                                     <div class="star-rating-outer" style="display: inline-block; position: relative; font-size: 16px; color: #e9ecef; white-space: nowrap; letter-spacing: 2px;">
                                         <div class="star-rating-inner" id="view_rating_stars_inner" style="position: absolute; top: 0; left: 0; white-space: nowrap; overflow: hidden; color: #ffc107; width: 0%; transition: width 0.3s ease;">
                                             &#9733;&#9733;&#9733;&#9733;&#9733;
                                         </div>
                                         &#9733;&#9733;&#9733;&#9733;&#9733;
                                     </div>
                                 </div>
                            </div>
                        </div>
                    </div>
                </div>

                <h5 class="fw-bold mb-3 fs-sm border-bottom pb-2">Completed Ratings</h5>

                <div id="viewQuestionsContainer">
                    <!-- Dynamic Question Results -->
                </div>

                <!-- Overall Comments card -->
                <div class="card border border-light-subtle shadow-none mb-2 mt-4">
                    <div class="card-header bg-light py-2">
                        <h6 class="fw-semibold text-dark mb-0 fs-xs">Overall Comments</h6>
                    </div>
                    <div class="card-body">
                        <div class="p-2 bg-light rounded text-muted fs-xs fst-italic" id="view_overall_comments" style="white-space: pre-wrap;">
                            -
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ==============================================
     JAVASCRIPT LOGIC
     ============================================== -->
<script>
    var currentTab = 'All';
    var activeReviewId = 0;
    var isAdminUser = @(isAdmin ? "true" : "false");

    $(document).ready(function () {
        LoadDropdowns();

        // 1. Hook search extension for DataTable filters
        if ($.fn.dataTable) {
            $.fn.dataTable.ext.search.push(
                function (settings, data, dataIndex) {
                    if (settings.nTable.id !== 'checkbox-select-data') return true;

                    // Filter values
                    var cycleVal = $("#filterReviewCycle").val();
                    var startDateVal = $("#filterStartDate").val();
                    var endDateVal = $("#filterEndDate").val();

                    // Review Cycle Match
                    if (cycleVal && data[3] !== cycleVal) {
                        return false;
                    }

                    // Tab status Match (Status is column 6)
                    var statusText = data[6].trim();
                    if (currentTab !== 'All' && statusText !== currentTab) {
                        return false;
                    }

                    // Date range Match (Date is column 4)
                    if (startDateVal || endDateVal) {
                        var dateStr = data[4].trim(); // yyyy-MM-dd
                        if (dateStr) {
                            var rowDate = new Date(dateStr);
                            rowDate.setHours(0,0,0,0);

                            if (startDateVal) {
                                var startDate = new Date(startDateVal);
                                startDate.setHours(0,0,0,0);
                                if (rowDate < startDate) return false;
                            }
                            if (endDateVal) {
                                var endDate = new Date(endDateVal);
                                endDate.setHours(23,59,59,999);
                                if (rowDate > endDate) return false;
                            }
                        }
                    }

                    return true;
                }
            );

            // Re-apply filter draw on input trigger
            $("#filterReviewCycle").on("change", function () { ApplyFilters(); });
            $("#filterStartDate").on("change", function () { ApplyFilters(); });
            $("#filterEndDate").on("change", function () { ApplyFilters(); });

            // Initialize counts
            UpdateTabCounts();
        }

        $("#ScheduleReviewModal").on("show.bs.modal", function () {
            if ($("#sch_review_id").val() === "0") {
                $("#ScheduleReviewForm")[0].reset();
                $("#ScheduleReviewForm").removeClass('was-validated');
            }
        });
    });

    function ApplyFilters() {
        var table = $('#checkbox-select-data').DataTable();
        table.draw();
        UpdateTabCounts();
    }

    function UpdateTabCounts() {
        var table = $('#checkbox-select-data').DataTable();
        
        var countAll = 0;
        var countSch = 0;
        var countProg = 0;
        var countComp = 0;

        table.rows().every(function (rowIdx, tableLoop, rowLoop) {
            var rowData = this.data();
            var statusText = $(rowData[6]).text().trim() || rowData[6].trim();

            if (MatchesFiltersExceptTab(rowData)) {
                countAll++;
                if (statusText === 'Scheduled') countSch++;
                else if (statusText === 'In Progress') countProg++;
                else if (statusText === 'Completed') countComp++;
            }
        });

        $("#countAll").text(countAll);
        $("#countScheduled").text(countSch);
        $("#countInProgress").text(countProg);
        $("#countCompleted").text(countComp);
    }

    function MatchesFiltersExceptTab(data) {
        var cycleVal = $("#filterReviewCycle").val();
        var startDateVal = $("#filterStartDate").val();
        var endDateVal = $("#filterEndDate").val();

        if (cycleVal && data[3] !== cycleVal) {
            return false;
        }

        if (startDateVal || endDateVal) {
            var dateStr = data[4].trim();
            if (dateStr) {
                var rowDate = new Date(dateStr);
                rowDate.setHours(0,0,0,0);

                if (startDateVal) {
                    var startDate = new Date(startDateVal);
                    startDate.setHours(0,0,0,0);
                    if (rowDate < startDate) return false;
                }
                if (endDateVal) {
                    var endDate = new Date(endDateVal);
                    endDate.setHours(23,59,59,999);
                    if (rowDate > endDate) return false;
                }
            }
        }

        return true;
    }

    function SetCurrentTab(tabName) {
        currentTab = tabName;
        
        // Update nav links active styling
        $("#reviewTabs .nav-link").removeClass("active");
        event.currentTarget.classList.add("active");
        
        ApplyFilters();
    }

    function ClearFilters() {
        var table = $('#checkbox-select-data').DataTable();
        table.search(''); // Clear default DataTable search
        $("#filterReviewCycle").val('');
        $("#filterStartDate").val('');
        $("#filterEndDate").val('');
        ApplyFilters();
    }

    function LoadDropdowns() {
        // Load Employees
        $.ajax({
            url: '/Performance/GetActiveEmployees',
            type: 'GET',
            success: function (data) {
                var empChoicesList = [{ value: '', label: 'Select Employee', selected: true, placeholder: true }];
                var revChoicesList = [{ value: '', label: 'Select Reviewer', selected: true, placeholder: true }];
                
                $.each(data, function (i, item) {
                    var name = item.FirstName + " " + item.LastName;
                    empChoicesList.push({
                        value: item.Id.toString(),
                        label: name
                    });
                    revChoicesList.push({
                        value: item.Id.toString(),
                        label: name
                    });
                });
                
                var elEmp = document.getElementById("sch_employee_id");
                if (elEmp && elEmp.choicesInstance) {
                    elEmp.choicesInstance.clearStore();
                    elEmp.choicesInstance.setChoices(empChoicesList, 'value', 'label', true);
                } else {
                    var selectEmp = $("#sch_employee_id");
                    selectEmp.empty().append('<option value="">Select Employee</option>');
                    $.each(data, function (i, item) {
                        selectEmp.append('<option value="' + item.Id + '">' + (item.FirstName + " " + item.LastName) + '</option>');
                    });
                }
                
                var elRev = document.getElementById("sch_reviewer_id");
                if (elRev && elRev.choicesInstance) {
                    elRev.choicesInstance.clearStore();
                    elRev.choicesInstance.setChoices(revChoicesList, 'value', 'label', true);
                } else {
                    var selectRev = $("#sch_reviewer_id");
                    selectRev.empty().append('<option value="">Select Reviewer</option>');
                    $.each(data, function (i, item) {
                        selectRev.append('<option value="' + item.Id + '">' + (item.FirstName + " " + item.LastName) + '</option>');
                    });
                }
            }
        });

        // Load Review Cycles
        $.ajax({
            url: '/Performance/GetActiveReviewCycles',
            type: 'GET',
            success: function (data) {
                var cycleChoicesList = [{ value: '', label: 'Select Review Cycle', selected: true, placeholder: true }];
                $.each(data, function (i, item) {
                    cycleChoicesList.push({
                        value: item.ReviewCycleId.toString(),
                        label: item.ReviewCycleName
                    });
                });
                
                var elCycle = document.getElementById("sch_cycle_id");
                if (elCycle && elCycle.choicesInstance) {
                    elCycle.choicesInstance.clearStore();
                    elCycle.choicesInstance.setChoices(cycleChoicesList, 'value', 'label', true);
                } else {
                    var selectCycle = $("#sch_cycle_id");
                    selectCycle.empty().append('<option value="">Select Review Cycle</option>');
                    $.each(data, function (i, item) {
                        selectCycle.append('<option value="' + item.ReviewCycleId + '">' + item.ReviewCycleName + '</option>');
                    });
                }
            }
        });
    }

    // Schedule / Edit Methods
    function OpenScheduleModal() {
        $("#sch_review_id").val("0");
        $("#ScheduleReviewForm")[0].reset();
        $("#ScheduleReviewForm").removeClass('was-validated');
        
        var elEmp = document.getElementById("sch_employee_id");
        if (elEmp && elEmp.choicesInstance) {
            elEmp.choicesInstance.setChoiceByValue("");
        } else {
            $("#sch_employee_id").val("");
        }

        var elRev = document.getElementById("sch_reviewer_id");
        if (elRev && elRev.choicesInstance) {
            elRev.choicesInstance.setChoiceByValue("");
        } else {
            $("#sch_reviewer_id").val("");
        }

        var elCycle = document.getElementById("sch_cycle_id");
        if (elCycle && elCycle.choicesInstance) {
            elCycle.choicesInstance.setChoiceByValue("");
        } else {
            $("#sch_cycle_id").val("");
        }

        var elStatus = document.getElementById("sch_status");
        if (elStatus && elStatus.choicesInstance) {
            elStatus.choicesInstance.setChoiceByValue("Scheduled");
        } else {
            $("#sch_status").val("Scheduled");
        }

        $("#ScheduleReviewModalLabel").text("Schedule Performance Review");
        $("#btnScheduleSubmit").text("Schedule Review");
        $("#ScheduleReviewModal").modal("show");
    }

    function OpenEditReviewModal(id) {
        $.ajax({
            url: '/Performance/GetEmployeeReviewById',
            type: 'GET',
            data: { id: id },
            success: function (res) {
                if (res.success && res.data) {
                    var r = res.data;
                    $("#sch_review_id").val(r.ReviewId);
                    
                    var elEmp = document.getElementById("sch_employee_id");
                    if (elEmp && elEmp.choicesInstance) {
                        elEmp.choicesInstance.setChoiceByValue(r.EmployeeId.toString());
                    } else {
                        $("#sch_employee_id").val(r.EmployeeId);
                    }

                    var elRev = document.getElementById("sch_reviewer_id");
                    if (elRev && elRev.choicesInstance) {
                        elRev.choicesInstance.setChoiceByValue(r.ReviewerId.toString());
                    } else {
                        $("#sch_reviewer_id").val(r.ReviewerId);
                    }

                    var elCycle = document.getElementById("sch_cycle_id");
                    if (elCycle && elCycle.choicesInstance) {
                        elCycle.choicesInstance.setChoiceByValue(r.ReviewCycleId.toString());
                    } else {
                        $("#sch_cycle_id").val(r.ReviewCycleId);
                    }
                    
                    var dateObj = new Date(parseInt(r.ReviewDate.substr(6)));
                    var yyyy = dateObj.getFullYear();
                    var mm = String(dateObj.getMonth() + 1).padStart(2, '0');
                    var dd = String(dateObj.getDate()).padStart(2, '0');
                    $("#sch_date").val(yyyy + '-' + mm + '-' + dd);

                    var elStatus = document.getElementById("sch_status");
                    if (elStatus && elStatus.choicesInstance) {
                        elStatus.choicesInstance.setChoiceByValue(r.Status);
                    } else {
                        $("#sch_status").val(r.Status);
                    }

                    $("#ScheduleReviewModalLabel").text("Edit Scheduled Review");
                    $("#btnScheduleSubmit").text("Save Changes");
                    $("#ScheduleReviewForm").removeClass('was-validated');
                    $("#ScheduleReviewModal").modal("show");
                } else {
                    alert("Error: " + res.message);
                }
            }
        });
    }

    function SubmitScheduleReview(e) {
        e.preventDefault();
        var form = $("#ScheduleReviewForm")[0];
        if (!form.checkValidity()) {
            e.stopPropagation();
            $(form).addClass('was-validated');
            return;
        }

        var formData = {
            ReviewId: parseInt($("#sch_review_id").val()),
            EmployeeId: parseInt($("#sch_employee_id").val()),
            ReviewerId: parseInt($("#sch_reviewer_id").val()),
            ReviewCycleId: parseInt($("#sch_cycle_id").val()),
            ReviewDate: $("#sch_date").val(),
            Status: $("#sch_status").val()
        };

        $.ajax({
            url: '/Performance/SaveEmployeeReview',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(formData),
            success: function (res) {
                if (res.success) {
                    location.reload();
                } else {
                    alert("Error: " + res.message);
                }
            }
        });
    }

    // Conduct Review Methods
    function OpenConductReviewModal(reviewId, employeeId) {
        activeReviewId = reviewId;
        
        // Find review detail row from DOM or internal model
        var rowEl = $(event.currentTarget).closest('tr');
        var empName = rowEl.find('td:nth-child(2) .fw-semibold').text();
        var revName = rowEl.find('td:nth-child(3) .fw-semibold').text();
        var cycleName = rowEl.find('td:nth-child(4)').text();
        var dateText = rowEl.find('td:nth-child(5) span').text();

        $("#cond_employee_name").text(empName);
        $("#cond_reviewer_name").text(revName);
        $("#cond_cycle_name").text(cycleName);
        $("#cond_date").text(dateText);
        $("#cond_overall_comments").val("");

        // Fetch indicators list
        $.ajax({
            url: '/Performance/GetIndicatorsForEmployee',
            type: 'GET',
            data: { employeeId: employeeId },
            success: function (res) {
                if (res.success) {
                    RenderConductIndicators(res.data);
                    $("#ConductReviewModal").modal("show");
                } else {
                    alert("Error loading indicators: " + res.message);
                }
            }
        });
    }

    function RenderConductIndicators(indicators) {
        var container = $("#conductQuestionsContainer");
        container.empty();

        if (indicators.length === 0) {
            container.append('<div class="alert alert-warning text-center fs-xs py-2">No active performance indicators/questions configured for this employee\'s role.</div>');
            return;
        }

        var categories = {};
        $.each(indicators, function (i, item) {
            if (!categories[item.CategoryName]) {
                categories[item.CategoryName] = [];
            }
            categories[item.CategoryName].push(item);
        });

        $.each(categories, function (catName, items) {
            var catHtml = '<div class="card border border-light-subtle shadow-none mb-3">' +
                '<div class="card-header bg-light py-2">' +
                    '<h6 class="fw-semibold text-dark mb-0 fs-xs">' + catName + '</h6>' +
                '</div>' +
                '<div class="card-body p-3">';

            $.each(items, function (i, ind) {
                var meas = ind.MeasurementUnit ? ind.MeasurementUnit : '-';
                var target = ind.TargetValue ? ind.TargetValue : '-';

                catHtml += '<div class="indicator-row pb-3 mb-3 border-bottom border-light-subtle" data-indicator-id="' + ind.IndicatorId + '">' +
                    '<div class="row align-items-center">' +
                        '<div class="col-md-6">' +
                            '<h6 class="fw-semibold text-dark fs-sm mb-1">' + ind.IndicatorName + '</h6>' +
                            '<p class="text-muted fs-xxs mb-1">' + ind.Description + '</p>' +
                            '<div class="text-muted fs-xxs">' +
                                '<strong>Measurement:</strong> ' + meas + ' | <strong>Target:</strong> ' + target +
                            '</div>' +
                        '</div>' +
                        '<div class="col-md-6 mt-2 mt-md-0">' +
                            '<div class="d-flex align-items-center justify-content-between mb-1">' +
                                '<span class="text-muted fs-xxs">Rating</span>' +
                                '<span class="badge rating-badge" id="badge_rating_' + ind.IndicatorId + '">3.0 \u2605</span>' +
                            '</div>' +
                            '<input type="range" class="form-range rating-slider" min="1" max="5" step="0.1" value="3.0" oninput="OnSliderChange(this, ' + ind.IndicatorId + ')">' +
                            '<div class="d-flex justify-content-between text-muted fs-xxs mt-1" style="font-size: 9px;">' +
                                '<span>Poor</span>' +
                                '<span>Average</span>' +
                                '<span>Excellent</span>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                    '<textarea class="form-control form-control-sm mt-2 ind-comments" rows="1" placeholder="Add specific feedback for this indicator..."></textarea>' +
                '</div>';
            });

            // Clean last row border
            catHtml = catHtml.replace(/border-bottom border-light-subtle pb-3 mb-3"(?![\s\S]*border-bottom border-light-subtle pb-3 mb-3")/, '"');

            catHtml += '</div></div>';
            container.append(catHtml);
        });
    }

    function OnSliderChange(slider, indId) {
        $("#badge_rating_" + indId).text(parseFloat(slider.value).toFixed(1) + " \u2605");
    }

    function SubmitConductedReview(e) {
        e.preventDefault();

        var ratings = [];
        var rows = $("#conductQuestionsContainer .indicator-row");

        if (rows.length === 0) {
            alert("No indicators/questions to evaluate.");
            return;
        }

        $.each(rows, function (i, el) {
            var indId = $(el).data("indicator-id");
            var val = parseFloat($(el).find(".rating-slider").val());
            var comm = $(el).find(".ind-comments").val();

            ratings.push({
                IndicatorId: indId,
                RatingValue: val,
                Comments: comm
            });
        });

        var submission = {
            ReviewId: activeReviewId,
            OverallComments: $("#cond_overall_comments").val(),
            Ratings: ratings
        };

        $.ajax({
            url: '/Performance/SubmitEmployeeReview',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(submission),
            success: function (res) {
                if (res.success) {
                    location.reload();
                } else {
                    alert("Error: " + res.message);
                }
            }
        });
    }

    // View Completed Review Methods
    function OpenViewReviewModal(reviewId) {
        $.ajax({
            url: '/Performance/GetConductedReviewDetails',
            type: 'GET',
            data: { reviewId: reviewId },
            success: function (res) {
                if (res.success && res.review) {
                    var r = res.review;
                    $("#view_employee_name").text(r.EmployeeName);
                    $("#view_reviewer_name").text(r.ReviewerName);
                    $("#view_cycle_name").text(r.ReviewCycleName);

                    var dateObj = new Date(parseInt(r.ReviewDate.substr(6)));
                    var yyyy = dateObj.getFullYear();
                    var mm = String(dateObj.getMonth() + 1).padStart(2, '0');
                    var dd = String(dateObj.getDate()).padStart(2, '0');
                    $("#view_date").text(yyyy + '-' + mm + '-' + dd);

                    $("#view_overall_rating").text(r.Rating ? r.Rating.toFixed(1) : '-');

                    if (r.Rating) {
                        var percent = (parseFloat(r.Rating) / 5.0) * 100;
                        $("#view_rating_stars_inner").css("width", percent + "%");
                    } else {
                        $("#view_rating_stars_inner").css("width", "0%");
                    }

                    $("#view_overall_comments").text(r.OverallComments ? r.OverallComments : 'No overall review remarks recorded.');

                    RenderViewIndicators(res.ratings);
                    $("#ViewReviewModal").modal("show");
                } else {
                    alert("Error: " + res.message);
                }
            }
        });
    }

    function RenderViewIndicators(ratings) {
        var container = $("#viewQuestionsContainer");
        container.empty();

        if (ratings.length === 0) {
            container.append('<div class="alert alert-light text-center text-muted fs-xs py-2">No rating indicator marks logged.</div>');
            return;
        }

        var categories = {};
        $.each(ratings, function (i, item) {
            if (!categories[item.IndicatorCategoryName]) {
                categories[item.IndicatorCategoryName] = [];
            }
            categories[item.IndicatorCategoryName].push(item);
        });

        $.each(categories, function (catName, items) {
            var catHtml = '<div class="card border border-light-subtle shadow-none mb-3">' +
                '<div class="card-header bg-light py-2">' +
                    '<h6 class="fw-semibold text-dark mb-0 fs-xs">' + catName + '</h6>' +
                '</div>' +
                '<div class="card-body p-3">';

            $.each(items, function (i, r) {
                var meas = r.MeasurementUnit ? r.MeasurementUnit : '-';
                var target = r.TargetValue ? r.TargetValue : '-';
                var feedbackHtml = r.Comments ?
                    '<div class="bg-light p-2 rounded mt-2 border-start border-3 border-light-subtle fs-xxs text-muted fst-italic">Feedback: ' + r.Comments + '</div>' :
                    '<div class="text-muted font-size-10 mt-1 fst-italic">No comment feedback added.</div>';

                var badgeClass = 'bg-danger-subtle text-danger';
                if (r.RatingValue >= 4) {
                    badgeClass = 'bg-success-subtle text-success';
                } else if (r.RatingValue >= 3) {
                    badgeClass = 'bg-primary-subtle text-primary';
                } else if (r.RatingValue >= 2) {
                    badgeClass = 'bg-warning-subtle text-warning';
                }

                catHtml += '<div class="pb-3 mb-3 border-bottom border-light-subtle">' +
                    '<div class="row align-items-center">' +
                        '<div class="col-md-8">' +
                            '<h6 class="fw-semibold text-dark fs-sm mb-1">' + r.IndicatorName + '</h6>' +
                            '<p class="text-muted fs-xxs mb-1">' + r.Description + '</p>' +
                            '<div class="text-muted fs-xxs">' +
                                '<strong>Measurement:</strong> ' + meas + ' | <strong>Target:</strong> ' + target +
                            '</div>' +
                        '</div>' +
                        '<div class="col-md-4 mt-2 mt-md-0 text-md-end">' +
                            '<div class="d-inline-flex align-items-center">' +
                                '<span class="badge ' + badgeClass + ' py-1 px-2 rounded-pill fw-bold text-uppercase fs-xxs me-2">Score: ' + parseFloat(r.RatingValue).toFixed(1) + ' / 5</span>' +
                                '<div class="star-rating-outer" style="display: inline-block; position: relative; font-size: 13px; color: #e9ecef; white-space: nowrap; letter-spacing: 1px; vertical-align: middle;">' +
                                    '<div class="star-rating-inner" style="position: absolute; top: 0; left: 0; white-space: nowrap; overflow: hidden; color: #ffc107; width: ' + ((parseFloat(r.RatingValue) / 5.0) * 100) + '%;">' +
                                        '&#9733;&#9733;&#9733;&#9733;&#9733;' +
                                    '</div>' +
                                    '&#9733;&#9733;&#9733;&#9733;&#9733;' +
                                '</div>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                    feedbackHtml +
                '</div>';
            });

            // Clean last row border
            catHtml = catHtml.replace(/border-bottom border-light-subtle pb-3 mb-3"(?![\s\S]*border-bottom border-light-subtle pb-3 mb-3")/, '"');

            catHtml += '</div></div>';
            container.append(catHtml);
        });
    }

    // Reset Review
    function ResetReview(id) {
        if (confirm("Are you sure you want to reset this review? This will clear all submitted ratings and comments, resetting status back to Scheduled.")) {
            $.ajax({
                url: '/Performance/ResetEmployeeReview',
                type: 'POST',
                data: { id: id },
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert("Error: " + res.message);
                    }
                }
            });
        }
    }

    // Delete Review
    function DeleteReview(id) {
        if (confirm("Are you sure you want to delete this scheduled performance review? This action cannot be undone.")) {
            $.ajax({
                url: '/Performance/DeleteEmployeeReview',
                type: 'POST',
                data: { id: id },
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert("Error: " + res.message);
                    }
                }
            });
        }
    }
</script>

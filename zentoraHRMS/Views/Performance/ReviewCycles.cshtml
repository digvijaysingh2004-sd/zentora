@model IEnumerable<zentoraHRMS.Models.ReviewCycleModel>
@{
    ViewBag.Title = "Review Cycles";
}

<style>
    .freq-badge {
        background-color: #eff6ff !important;
        color: #2563eb !important;
        border: 1px solid #bfdbfe !important;
        font-weight: 500 !important;
        text-transform: none !important;
        letter-spacing: normal !important;
    }

    [data-bs-theme=dark] .freq-badge {
        background-color: rgba(37, 99, 235, 0.15) !important;
        color: #93c5fd !important;
        border: 1px solid rgba(37, 99, 235, 0.4) !important;
    }

    /* Prevent Choices.js select dropdowns from being cut off or layered behind the modal footer */
    .choices.is-open {
        z-index: 1050 !important;
    }
    .choices__list--dropdown {
        z-index: 9999 !important;
    }
</style>

<div class="container-fluid">
    <div class="row justify-content-center py-5">
        <div class="col-xxl-5 col-xl-7 text-center">
            <a href="@Url.Action("Index","Home")" class="badge badge-default fw-normal shadow px-2 py-1 mb-2 fst-italic fs-xxs">
                <i data-lucide="square-check" class="fs-sm me-1"></i> DashBoard
            </a>
            <h3 class="fw-bold">Review Cycles</h3>
            <p class="text-muted">Manage company-wide performance review cycles, frequency schedules, and status.</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-xxl-12">
            <div class="card rounded-2">
                <div class="card-header justify-content-between align-items-center d-flex">
                    <h5 class="card-title mb-0">Review Cycle Details</h5>
                    <button type="button" class="btn btn-sm btn-soft-primary" data-bs-toggle="modal" data-bs-target="#AddReviewCycleModal">
                        <i class="me-1" data-lucide="plus"></i> Add Review Cycle
                    </button>
                </div>

                <div class="card-body">
                    <table id="checkbox-select-data" class="table table-striped dt-responsive checkbox-select-datatable align-middle mb-0">
                        <thead class="thead-sm text-uppercase fs-xxs">
                            <tr>
                                <th class="fs-sm" style="width: 1%;"></th>
                                <th>Review Cycle Name</th>
                                <th>Frequency</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model)
                            {
                                <tr>
                                    <td class="fs-sm" style="width: 1%;"></td>
                                    <td>
                                        <div class="fw-semibold text-dark fs-sm">@c.ReviewCycleName</div>
                                        <div class="text-muted fs-xs mt-1 desc-container">
                                            @if (string.IsNullOrEmpty(c.Description))
                                            {
                                                <span>-</span>
                                            }
                                            else if (c.Description.Length > 100)
                                            {
                                                <span class="desc-short">@c.Description.Substring(0, 100)...</span>
                                                <span class="desc-full d-none">@c.Description</span>
                                                <a href="javascript:void(0);" class="text-primary ms-1 toggle-desc fs-xxs fw-medium" onclick="ToggleDescription(this)">Show More</a>
                                            }
                                            else
                                            {
                                                <span>@c.Description</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge freq-badge">@c.Frequency</span>
                                    </td>
                                    <td>
                                        @if (c.Status == "Active")
                                        {
                                            <span class="badge bg-success-subtle text-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="javascript:void(0);" onclick="UpdateReviewCycle(@c.ReviewCycleId)" class="btn btn-sm btn-soft-info mt-1" title="Update"><i data-lucide="square-pen"></i></a>
                                        <a href="javascript:void(0);" onclick="DeleteReviewCycle(@c.ReviewCycleId)" class="btn btn-sm btn-soft-danger mt-1" title="Delete"><i data-lucide="trash-2"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- AddReviewCycle Modal -->
    <div id="AddReviewCycleModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="ReviewCycleForm" class="needs-validation" novalidate method="post">
                    <div class="modal-header">
                        <h4 class="modal-title">Add Review Cycle</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="ReviewCycleName" class="form-label">Review Cycle Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="ReviewCycleName" required placeholder="Enter review cycle name">
                        </div>
                        <div class="mb-3">
                            <label for="Description" class="form-label">Description</label>
                            <textarea class="form-control" id="Description" rows="3" placeholder="Enter description of review cycle"></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="Frequency" class="form-label">Frequency</label>
                            <select class="form-select" id="Frequency" data-choices data-choices-search-false>
                                <option value="Monthly">Monthly</option>
                                <option value="Annual" selected>Annual</option>
                                <option value="Semi-Annual">Semi-Annual</option>
                                <option value="One-Time">One-Time</option>
                                <option value="Quarterly">Quarterly</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="Status" class="form-label">Status</label>
                            <select class="form-select" id="Status" data-choices data-choices-search-false>
                                <option value="Active" selected>Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-soft-primary">Save changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- UpdateReviewCycle Modal -->
    <div id="UpdateReviewCycleModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="UpdateReviewCycleForm" class="needs-validation" novalidate method="post">
                    <div class="modal-header">
                        <h4 class="modal-title">Update Review Cycle</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="update_id" />
                        <div class="mb-3">
                            <label for="uReviewCycleName" class="form-label">Review Cycle Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="uReviewCycleName" required>
                        </div>
                        <div class="mb-3">
                            <label for="uDescription" class="form-label">Description</label>
                            <textarea class="form-control" id="uDescription" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="uFrequency" class="form-label">Frequency</label>
                            <select class="form-select" id="uFrequency" data-choices data-choices-search-false>
                                <option value="Monthly">Monthly</option>
                                <option value="Annual">Annual</option>
                                <option value="Semi-Annual">Semi-Annual</option>
                                <option value="One-Time">One-Time</option>
                                <option value="Quarterly">Quarterly</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="uStatus" class="form-label">Status</label>
                            <select class="form-select" id="uStatus" data-choices data-choices-search-false>
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-soft-primary">Save changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $("#AddReviewCycleModal").on("show.bs.modal", function () {
            $("#ReviewCycleForm")[0].reset();
            $("#ReviewCycleForm").removeClass('was-validated');
            
            var elFreq = document.getElementById("Frequency");
            if (elFreq && elFreq.choicesInstance) {
                elFreq.choicesInstance.setChoiceByValue("Annual");
            }
            
            var elStatus = document.getElementById("Status");
            if (elStatus && elStatus.choicesInstance) {
                elStatus.choicesInstance.setChoiceByValue("Active");
            }
        });

        $("#ReviewCycleForm").on("submit", function (e) {
            e.preventDefault();
            if (!this.checkValidity()) {
                e.stopPropagation();
                $(this).addClass('was-validated');
                return;
            }

            var formData = {
                ReviewCycleName: $("#ReviewCycleName").val(),
                Description: $("#Description").val(),
                Frequency: $("#Frequency").val(),
                Status: $("#Status").val()
            };

            $.ajax({
                url: '/Performance/SaveReviewCycle',
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(formData),
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert("Error: " + res.message);
                    }
                }
            });
        });

        $("#UpdateReviewCycleForm").on("submit", function (e) {
            e.preventDefault();
            if (!this.checkValidity()) {
                e.stopPropagation();
                $(this).addClass('was-validated');
                return;
            }

            var formData = {
                ReviewCycleId: $("#update_id").val(),
                ReviewCycleName: $("#uReviewCycleName").val(),
                Description: $("#uDescription").val(),
                Frequency: $("#uFrequency").val(),
                Status: $("#uStatus").val()
            };

            $.ajax({
                url: '/Performance/SaveReviewCycle',
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(formData),
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert("Error: " + res.message);
                    }
                }
            });
        });
    });

    function UpdateReviewCycle(id) {
        $.ajax({
            url: '/Performance/GetReviewCycle',
            type: 'GET',
            data: { id: id },
            success: function (res) {
                if (res.success && res.data) {
                    var data = res.data;
                    $("#update_id").val(data.ReviewCycleId);
                    $("#uReviewCycleName").val(data.ReviewCycleName);
                    $("#uDescription").val(data.Description);
                    
                    var elFreq = document.getElementById("uFrequency");
                    if (elFreq && elFreq.choicesInstance) {
                        elFreq.choicesInstance.setChoiceByValue(data.Frequency);
                    } else {
                        $("#uFrequency").val(data.Frequency);
                    }
                    
                    var elStatus = document.getElementById("uStatus");
                    if (elStatus && elStatus.choicesInstance) {
                        elStatus.choicesInstance.setChoiceByValue(data.Status);
                    } else {
                        $("#uStatus").val(data.Status);
                    }
                    
                    $("#UpdateReviewCycleForm").removeClass('was-validated');
                    $("#UpdateReviewCycleModal").modal("show");
                } else {
                    alert("Error: " + res.message);
                }
            }
        });
    }

    function DeleteReviewCycle(id) {
        if (confirm("Are you sure you want to delete this Review Cycle?")) {
            $.ajax({
                url: '/Performance/DeleteReviewCycle',
                type: "POST",
                data: { id: id },
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert("Error: " + res.message);
                    }
                }
            });
        }
    }

    function ToggleDescription(btn) {
        var container = $(btn).closest('.desc-container');
        var shortText = container.find('.desc-short');
        var fullText = container.find('.desc-full');
        
        if (fullText.hasClass('d-none')) {
            fullText.removeClass('d-none');
            shortText.addClass('d-none');
            $(btn).text('Show Less');
        } else {
            fullText.addClass('d-none');
            shortText.removeClass('d-none');
            $(btn).text('Show More');
        }
    }
</script>

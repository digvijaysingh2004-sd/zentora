@model IEnumerable<zentoraHRMS.Models.ReviewCycleModel>
@{
    ViewBag.Title = "Review Cycles";
}

<div class="container-fluid">
    <div class="row justify-content-center py-5">
        <div class="col-xxl-5 col-xl-7 text-center">
            <a href="@Url.Action("Index","Home")" class="badge badge-default fw-normal shadow px-2 py-1 mb-2 fst-italic fs-xxs">
                <i data-lucide="square-check" class="fs-sm me-1"></i> DashBoard
            </a>
            <h3 class="fw-bold">Review Cycles</h3>
            <p class="text-muted">Manage company-wide performance review cycles, timelines, and status.</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-xxl-12">
            <div class="card rounded-2">
                <div class="card-header justify-content-between align-items-center d-flex">
                    <h5 class="card-title mb-0">Review Cycle Details</h5>
                    <button type="button" class="btn btn-sm btn-soft-primary" data-bs-toggle="modal" data-bs-target="#AddReviewCycleModal">
                        <i class="me-1" data-lucide="plus"></i> Add Review Cycle
                    </button>
                </div>

                <div class="card-body">
                    <table id="checkbox-select-data" class="table table-striped dt-responsive checkbox-select-datatable align-middle mb-0">
                        <thead class="thead-sm text-uppercase fs-xxs">
                            <tr>
                                <th class="fs-sm" style="width: 1%;"></th>
                                <th>Cycle Name</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model)
                            {
                                <tr>
                                    <td class="fs-sm" style="width: 1%;"></td>
                                    <td>
                                        <div class="fw-semibold text-dark fs-sm">@c.CycleName</div>
                                        <div class="text-muted fs-xs mt-1 desc-container">
                                            @if (string.IsNullOrEmpty(c.Description))
                                            {
                                                <span>-</span>
                                            }
                                            else if (c.Description.Length > 100)
                                            {
                                                <span class="desc-short">@c.Description.Substring(0, 100)...</span>
                                                <span class="desc-full d-none">@c.Description</span>
                                                <a href="javascript:void(0);" class="text-primary ms-1 toggle-desc fs-xxs fw-medium" onclick="ToggleDescription(this)">Show More</a>
                                            }
                                            else
                                            {
                                                <span>@c.Description</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-dark">@(c.StartDate.HasValue ? c.StartDate.Value.ToString("yyyy-MM-dd") : "-")</span>
                                    </td>
                                    <td>
                                        <span class="text-dark">@(c.EndDate.HasValue ? c.EndDate.Value.ToString("yyyy-MM-dd") : "-")</span>
                                    </td>
                                    <td>
                                        @if (c.Status == "Active")
                                        {
                                            <span class="badge bg-success-subtle text-success">Active</span>
                                        }
                                        else if (c.Status == "Completed")
                                        {
                                            <span class="badge bg-primary-subtle text-primary">Completed</span>
                                        }
                                        else if (c.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger-subtle text-danger">Cancelled</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning">@c.Status</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="javascript:void(0);" onclick="UpdateReviewCycle(@c.ReviewCycleId)" class="btn btn-sm btn-soft-info mt-1" title="Update"><i data-lucide="square-pen"></i></a>
                                        <a href="javascript:void(0);" onclick="DeleteReviewCycle(@c.ReviewCycleId)" class="btn btn-sm btn-soft-danger mt-1" title="Delete"><i data-lucide="trash-2"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- AddReviewCycle Modal -->
    <div id="AddReviewCycleModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="ReviewCycleForm" class="needs-validation" novalidate method="post">
                    <div class="modal-header">
                        <h4 class="modal-title">Add Review Cycle</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="CycleName" class="form-label">Cycle Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="CycleName" required placeholder="Enter cycle name">
                        </div>
                        <div class="mb-3">
                            <label for="Description" class="form-label">Description</label>
                            <textarea class="form-control" id="Description" rows="3" placeholder="Enter description of review cycle"></textarea>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="StartDate" class="form-label">Start Date</label>
                                <input type="date" class="form-control" id="StartDate">
                            </div>
                            <div class="col-md-6">
                                <label for="EndDate" class="form-label">End Date</label>
                                <input type="date" class="form-control" id="EndDate">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="Status" class="form-label">Status</label>
                            <select class="form-select" id="Status">
                                <option value="Draft" selected>Draft</option>
                                <option value="Active">Active</option>
                                <option value="Completed">Completed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-soft-primary">Save changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- UpdateReviewCycle Modal -->
    <div id="UpdateReviewCycleModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="UpdateReviewCycleForm" class="needs-validation" novalidate method="post">
                    <div class="modal-header">
                        <h4 class="modal-title">Update Review Cycle</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="update_id" />
                        <div class="mb-3">
                            <label for="uCycleName" class="form-label">Cycle Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="uCycleName" required>
                        </div>
                        <div class="mb-3">
                            <label for="uDescription" class="form-label">Description</label>
                            <textarea class="form-control" id="uDescription" rows="3"></textarea>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="uStartDate" class="form-label">Start Date</label>
                                <input type="date" class="form-control" id="uStartDate">
                            </div>
                            <div class="col-md-6">
                                <label for="uEndDate" class="form-label">End Date</label>
                                <input type="date" class="form-control" id="uEndDate">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="uStatus" class="form-label">Status</label>
                            <select class="form-select" id="uStatus">
                                <option value="Draft">Draft</option>
                                <option value="Active">Active</option>
                                <option value="Completed">Completed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-soft-primary">Save changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $("#AddReviewCycleModal").on("show.bs.modal", function () {
            $("#ReviewCycleForm")[0].reset();
            $("#ReviewCycleForm").removeClass('was-validated');
            var elStatus = document.getElementById("Status");
            if (elStatus && elStatus.choicesInstance) {
                elStatus.choicesInstance.setChoiceByValue("Draft");
            }
        });

        $("#ReviewCycleForm").on("submit", function (e) {
            e.preventDefault();
            if (!this.checkValidity()) {
                e.stopPropagation();
                $(this).addClass('was-validated');
                return;
            }

            var formData = {
                CycleName: $("#CycleName").val(),
                Description: $("#Description").val(),
                StartDate: $("#StartDate").val() ? $("#StartDate").val() : null,
                EndDate: $("#EndDate").val() ? $("#EndDate").val() : null,
                Status: $("#Status").val()
            };

            $.ajax({
                url: '/Performance/SaveReviewCycle',
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(formData),
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert("Error: " + res.message);
                    }
                }
            });
        });

        $("#UpdateReviewCycleForm").on("submit", function (e) {
            e.preventDefault();
            if (!this.checkValidity()) {
                e.stopPropagation();
                $(this).addClass('was-validated');
                return;
            }

            var formData = {
                ReviewCycleId: $("#update_id").val(),
                CycleName: $("#uCycleName").val(),
                Description: $("#uDescription").val(),
                StartDate: $("#uStartDate").val() ? $("#uStartDate").val() : null,
                EndDate: $("#uEndDate").val() ? $("#uEndDate").val() : null,
                Status: $("#uStatus").val()
            };

            $.ajax({
                url: '/Performance/SaveReviewCycle',
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(formData),
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert("Error: " + res.message);
                    }
                }
            });
        });
    });

    function UpdateReviewCycle(id) {
        $.ajax({
            url: '/Performance/GetReviewCycle',
            type: 'GET',
            data: { id: id },
            success: function (res) {
                if (res.success && res.data) {
                    var data = res.data;
                    $("#update_id").val(data.ReviewCycleId);
                    $("#uCycleName").val(data.CycleName);
                    $("#uDescription").val(data.Description);
                    $("#uStartDate").val(formatJsonDate(data.StartDate));
                    $("#uEndDate").val(formatJsonDate(data.EndDate));
                    
                    var elStatus = document.getElementById("uStatus");
                    if (elStatus && elStatus.choicesInstance) {
                        elStatus.choicesInstance.setChoiceByValue(data.Status);
                    } else {
                        $("#uStatus").val(data.Status);
                    }
                    
                    $("#UpdateReviewCycleForm").removeClass('was-validated');
                    $("#UpdateReviewCycleModal").modal("show");
                } else {
                    alert("Error: " + res.message);
                }
            }
        });
    }

    function DeleteReviewCycle(id) {
        if (confirm("Are you sure you want to delete this Review Cycle?")) {
            $.ajax({
                url: '/Performance/DeleteReviewCycle',
                type: "POST",
                data: { id: id },
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert("Error: " + res.message);
                    }
                }
            });
        }
    }

    function ToggleDescription(btn) {
        var container = $(btn).closest('.desc-container');
        var shortText = container.find('.desc-short');
        var fullText = container.find('.desc-full');
        
        if (fullText.hasClass('d-none')) {
            fullText.removeClass('d-none');
            shortText.addClass('d-none');
            $(btn).text('Show Less');
        } else {
            fullText.addClass('d-none');
            shortText.removeClass('d-none');
            $(btn).text('Show More');
        }
    }

    function formatJsonDate(jsonDate) {
        if (!jsonDate) return "";
        var date;
        if (typeof jsonDate === 'string' && jsonDate.indexOf('/Date(') !== -1) {
            date = new Date(parseInt(jsonDate.replace(/\/Date\((\d+)\)\//, '$1')));
        } else {
            date = new Date(jsonDate);
        }
        if (isNaN(date.getTime())) return "";
        
        var month = '' + (date.getMonth() + 1);
        var day = '' + date.getDate();
        var year = date.getFullYear();

        if (month.length < 2) month = '0' + month;
        if (day.length < 2) day = '0' + day;

        return [year, month, day].join('-');
    }
</script>

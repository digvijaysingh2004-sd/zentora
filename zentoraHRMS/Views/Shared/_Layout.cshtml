<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title | Zentora </title>

    <!-- App favicon -->
    <link rel="shortcut icon" href="~/assets/images/favicon.ico">

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Toastr CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <!-- Toastr JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <!-- Datatables css -->
    <link href="~/assets/plugins/datatables/select.bootstrap5.min.css" rel="stylesheet" type="text/css">
    <link href="~/assets/plugins/datatables/responsive.bootstrap5.min.css" rel="stylesheet" type="text/css">

    <!-- Theme Config Js -->
    <script src="~/assets/js/config.js"></script>

    <!-- Vendor css -->
    <link href="~/assets/css/vendors.min.css" rel="stylesheet" type="text/css">

    <!-- App css -->
    <link href="~/assets/css/app.min.css" rel="stylesheet" type="text/css">

    <!-- Icon css -->
    <script src="~/assets/plugins/lucide/lucide.min.js"></script>

    <!-- Choices Validation & Premium Glassmorphic Badge Styling -->
    <style>
        /* Global Brand Option 1 Theme Overrides (Vibrant Violet & Slate) */
        :root, [data-bs-theme=light] {
            --ins-primary: #8b5cf6 !important;
            --ins-primary-rgb: 139, 92, 246 !important;
            --ins-primary-text-emphasis: #5b21b6 !important;
            --ins-primary-bg-subtle: rgba(139, 92, 246, 0.12) !important;
            --ins-primary-border-subtle: rgba(139, 92, 246, 0.25) !important;
            --ins-link-color: #8b5cf6 !important;
            --ins-link-hover-color: #7c3aed !important;
            
            --ins-btn-primary-bg: #8b5cf6 !important;
            --ins-btn-primary-border-color: #8b5cf6 !important;
            --ins-btn-primary-hover-bg: #7c3aed !important;
            --ins-btn-primary-hover-border-color: #7c3aed !important;
            --ins-btn-primary-active-bg: #7c3aed !important;
            --ins-btn-primary-active-border-color: #7c3aed !important;
            --ins-focus-ring-color: rgba(139, 92, 246, 0.25) !important;

            --ins-sidenav-item-active-color: #8b5cf6 !important;
            --ins-sidenav-item-active-bg: transparent !important;
        }

        [data-bs-theme=dark] {
            --ins-primary: #a78bfa !important;
            --ins-primary-rgb: 167, 139, 250 !important;
            --ins-primary-text-emphasis: #dcbbfc !important;
            --ins-primary-bg-subtle: rgba(167, 139, 250, 0.15) !important;
            --ins-primary-border-subtle: rgba(167, 139, 250, 0.3) !important;
            --ins-link-color: #a78bfa !important;
            --ins-link-hover-color: #c084fc !important;
            
            --ins-btn-primary-bg: #8b5cf6 !important;
            --ins-btn-primary-border-color: #8b5cf6 !important;
            --ins-btn-primary-hover-bg: #a78bfa !important;
            --ins-btn-primary-hover-border-color: #a78bfa !important;
            --ins-btn-primary-active-bg: #a78bfa !important;
            --ins-btn-primary-active-border-color: #a78bfa !important;
            --ins-focus-ring-color: rgba(167, 139, 250, 0.25) !important;

            --ins-sidenav-item-active-color: #a78bfa !important;
            --ins-sidenav-item-active-bg: transparent !important;
        }

        /* Button Primary Global Override */
        .btn-primary {
            background-color: #8b5cf6 !important;
            border-color: #8b5cf6 !important;
            color: #ffffff !important;
        }
        .btn-primary:hover, .btn-primary:focus, .btn-primary:active {
            background-color: #7c3aed !important;
            border-color: #7c3aed !important;
            color: #ffffff !important;
        }
        
        [data-bs-theme=dark] .btn-primary {
            background-color: #8b5cf6 !important;
            border-color: #8b5cf6 !important;
            color: #ffffff !important;
        }
        [data-bs-theme=dark] .btn-primary:hover, 
        [data-bs-theme=dark] .btn-primary:focus, 
        [data-bs-theme=dark] .btn-primary:active {
            background-color: #a78bfa !important;
            border-color: #a78bfa !important;
            color: #120e24 !important;
        }

        /* Sidebar Navigation Active Text Color Fix (Transparent Active Bg) */
        .side-nav .side-nav-item.active > a,
        .side-nav .side-nav-item.active > a i,
        .side-nav .side-nav-item.active > a .menu-text,
        .side-nav .side-nav-item.active > a svg {
            color: #8b5cf6 !important;
            background-color: transparent !important;
        }

        [data-bs-theme=dark] .side-nav .side-nav-item.active > a,
        [data-bs-theme=dark] .side-nav .side-nav-item.active > a i,
        [data-bs-theme=dark] .side-nav .side-nav-item.active > a .menu-text,
        [data-bs-theme=dark] .side-nav .side-nav-item.active > a svg {
            color: #a78bfa !important;
            background-color: transparent !important;
        }
        /* Text primary and borders */
        .text-primary {
            color: #8b5cf6 !important;
        }
        [data-bs-theme=dark] .text-primary {
            color: #a78bfa !important;
        }
        .border-primary {
            border-color: #8b5cf6 !important;
        }
        [data-bs-theme=dark] .border-primary {
            border-color: #a78bfa !important;
        }

        /* Link primary overrides */
        .link-primary {
            color: #8b5cf6 !important;
        }
        .link-primary:hover {
            color: #7c3aed !important;
        }
        [data-bs-theme=dark] .link-primary {
            color: #a78bfa !important;
        }
        [data-bs-theme=dark] .link-primary:hover {
            color: #c084fc !important;
        }
        /* Input Elements Focus Border Override (No Box-Shadow Focus Rings) */
        .form-control:focus, 
        .form-select:focus,
        textarea:focus,
        .choices__inner:focus,
        .choices[is-focused] .choices__inner {
            border-color: #8b5cf6 !important;
            box-shadow: none !important;
        }

        [data-bs-theme=dark] .form-control:focus, 
        [data-bs-theme=dark] .form-select:focus,
        [data-bs-theme=dark] textarea:focus,
        [data-bs-theme=dark] .choices__inner:focus,
        [data-bs-theme=dark] .choices[is-focused] .choices__inner {
            border-color: #a78bfa !important;
            box-shadow: none !important;
        }
        select.is-invalid + .choices .choices__inner {
            border-color: #dc3545 !important;
        }
        .choices.is-invalid .choices__inner {
            border-color: #dc3545 !important;
        }
        select.is-invalid ~ .invalid-feedback {
            display: block !important;
        }

        /* Global Glassmorphic Badge Customization */
        .badge {
            font-size: 0.70em !important;
            padding: 0.35em 0.6em !important;
            font-weight: 600 !important;
            border-radius: 4px !important;
            backdrop-filter: blur(4px) !important;
            display: inline-block !important;
            text-transform: capitalize !important;
        }

        /* Success Status Badges */
        .badge.bg-success, 
        .badge.badge-soft-success, 
        .badge.bg-success-subtle,
        .badge.badge-success,
        .glass-badge-success {
            border: 1px solid rgba(46, 204, 113, 0.4) !important;
            background-color: rgba(46, 204, 113, 0.15) !important;
            color: #1b7a43 !important;
        }

        /* Danger Status Badges */
        .badge.bg-danger, 
        .badge.badge-soft-danger, 
        .badge.bg-danger-subtle,
        .badge.badge-danger,
        .glass-badge-danger {
            border: 1px solid rgba(231, 76, 60, 0.4) !important;
            background-color: rgba(231, 76, 60, 0.15) !important;
            color: #b02a1e !important;
        }

        /* Warning Status Badges */
        .badge.bg-warning, 
        .badge.badge-soft-warning, 
        .badge.bg-warning-subtle,
        .badge.badge-warning {
            border: 1px solid rgba(241, 196, 15, 0.4) !important;
            background-color: rgba(241, 196, 15, 0.15) !important;
            color: #9a7d0a !important;
        }

        /* Info Status Badges */
        .badge.bg-info, 
        .badge.badge-soft-info, 
        .badge.bg-info-subtle,
        .badge.badge-info {
            border: 1px solid rgba(52, 152, 219, 0.4) !important;
            background-color: rgba(52, 152, 219, 0.15) !important;
            color: #1f618d !important;
        }

        /* Primary & Default Badges */
        .badge.bg-primary, 
        .badge.badge-soft-primary, 
        .badge.bg-primary-subtle,
        .badge.badge-primary,
        .badge.badge-default {
            border: 1px solid rgba(155, 89, 182, 0.4) !important;
            background-color: rgba(155, 89, 182, 0.15) !important;
            color: #6c3483 !important;
        }

        /* Soft Primary Buttons Custom Border (e.g. Add Save buttons) */
        .btn-soft-primary {
            border: 1px solid rgba(139, 92, 246, 0.25) !important;
        }
        [data-bs-theme=dark] .btn-soft-primary {
            border: 1px solid rgba(167, 139, 250, 0.35) !important;
        }

        /* Premium Table Action Buttons Overrides (Transparent BGs by default, hover effects only) */
        .table .btn-soft-primary,
        .table .btn-soft-info,
        .table .btn-soft-danger,
        .table .btn-soft-success,
        .table .btn-soft-warning {
            background-color: transparent !important;
            border-color: transparent !important;
            color: #64748b !important; /* Neutral slate icon color */
            padding: 6px !important;
            border-radius: 6px !important;
            transition: all 0.2s ease !important;
            border: none !important;
            box-shadow: none !important;
            position: relative !important;
        }

        
        
        
        

        /* Make Action Icons a medium size */
        .table .btn-soft-primary i,
        .table .btn-soft-info i,
        .table .btn-soft-danger i,
        .table .btn-soft-success i,
        .table .btn-soft-warning i,
        .table .btn-soft-primary svg,
        .table .btn-soft-info svg,
        .table .btn-soft-danger svg,
        .table .btn-soft-success svg,
        .table .btn-soft-warning svg {
            width: 15px !important;
            height: 15px !important;
        }

        /* Custom Tooltip bubble (black and pointing down) upside the icon */
        .table .btn-soft-primary::after,
        .table .btn-soft-info::after,
        .table .btn-soft-danger::after,
        .table .btn-soft-success::after,
        .table .btn-soft-warning::after {
            content: attr(data-tooltip) !important;
            position: absolute !important;
            bottom: 125% !important;
            left: 50% !important;
            transform: translateX(-50%) translateY(5px) !important;
            background-color: #111827 !important; /* Black background */
            color: #ffffff !important;
            padding: 4px 10px !important;
            font-size: 11px !important;
            border-radius: 6px !important;
            white-space: nowrap !important;
            opacity: 0 !important;
            visibility: hidden !important;
            pointer-events: none !important;
            transition: all 0.18s cubic-bezier(0.4, 0, 0.2, 1) !important;
            font-weight: 600 !important;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.12) !important;
            z-index: 1050 !important;
        }

        /* Tooltip arrow */
        .table .btn-soft-primary::before,
        .table .btn-soft-info::before,
        .table .btn-soft-danger::before,
        .table .btn-soft-success::before,
        .table .btn-soft-warning::before {
            content: "" !important;
            position: absolute !important;
            bottom: 105% !important;
            left: 50% !important;
            transform: translateX(-50%) translateY(5px) !important;
            border-width: 5px !important;
            border-style: solid !important;
            border-color: #111827 transparent transparent transparent !important;
            opacity: 0 !important;
            visibility: hidden !important;
            pointer-events: none !important;
            transition: all 0.18s cubic-bezier(0.4, 0, 0.2, 1) !important;
            z-index: 1050 !important;
        }

        /* Trigger tooltips on hover */
        .table .btn-soft-primary:hover::after,
        .table .btn-soft-info:hover::after,
        .table .btn-soft-danger:hover::after,
        .table .btn-soft-success:hover::after,
        .table .btn-soft-warning:hover::after,
        .table .btn-soft-primary:hover::before,
        .table .btn-soft-info:hover::before,
        .table .btn-soft-danger:hover::before,
        .table .btn-soft-success:hover::before,
        .table .btn-soft-warning:hover::before {
            opacity: 1 !important;
            visibility: visible !important;
            transform: translateX(-50%) translateY(0) !important;
        }

        .table .btn-soft-primary:hover,
        .table .btn-soft-info:hover,
        .table .btn-soft-danger:hover,
        .table .btn-soft-success:hover,
        .table .btn-soft-warning:hover {
            background-color: rgba(0, 0, 0, 0.05) !important;
            color: #111827 !important;
        }

        /* Dark Mode support for action buttons inside tables */
        [data-bs-theme=dark] .table .btn-soft-primary,
        [data-bs-theme=dark] .table .btn-soft-info,
        [data-bs-theme=dark] .table .btn-soft-danger,
        [data-bs-theme=dark] .table .btn-soft-success,
        [data-bs-theme=dark] .table .btn-soft-warning {
            color: #9ca3af !important; /* Muted gray in dark mode */
            background-color: transparent !important;
            border: none !important;
        }
        
        [data-bs-theme=dark] .table .btn-soft-primary:hover,
        [data-bs-theme=dark] .table .btn-soft-info:hover,
        [data-bs-theme=dark] .table .btn-soft-danger:hover,
        [data-bs-theme=dark] .table .btn-soft-success:hover,
        [data-bs-theme=dark] .table .btn-soft-warning:hover {
            background-color: rgba(255, 255, 255, 0.08) !important;
            color: #ffffff !important;
        }

        /* Sidebar hover overrides - restore background and set text color to black in light mode, white in dark mode */
        .side-nav .side-nav-item .side-nav-link:hover,
        .side-nav .side-nav-item .side-nav-link:active,
        .side-nav .side-nav-item .side-nav-link:focus {
            background-color: var(--ins-sidenav-item-hover-bg) !important;
            color: #000000 !important;
        }
        .side-nav .side-nav-item .side-nav-link:hover i,
        .side-nav .side-nav-item .side-nav-link:hover .menu-text,
        .side-nav .side-nav-item .side-nav-link:hover svg,
        .side-nav .side-nav-item .side-nav-link:active i,
        .side-nav .side-nav-item .side-nav-link:active .menu-text,
        .side-nav .side-nav-item .side-nav-link:active svg,
        .side-nav .side-nav-item .side-nav-link:focus i,
        .side-nav .side-nav-item .side-nav-link:focus .menu-text,
        .side-nav .side-nav-item .side-nav-link:focus svg {
            color: #000000 !important;
        }

        [data-bs-theme=dark] .side-nav .side-nav-item .side-nav-link:hover,
        [data-bs-theme=dark] .side-nav .side-nav-item .side-nav-link:active,
        [data-bs-theme=dark] .side-nav .side-nav-item .side-nav-link:focus {
            background-color: var(--ins-sidenav-item-hover-bg) !important;
            color: #ffffff !important;
        }
        [data-bs-theme=dark] .side-nav .side-nav-item .side-nav-link:hover i,
        [data-bs-theme=dark] .side-nav .side-nav-item .side-nav-link:hover .menu-text,
        [data-bs-theme=dark] .side-nav .side-nav-item .side-nav-link:hover svg,
        [data-bs-theme=dark] .side-nav .side-nav-item .side-nav-link:active i,
        [data-bs-theme=dark] .side-nav .side-nav-item .side-nav-link:active .menu-text,
        [data-bs-theme=dark] .side-nav .side-nav-item .side-nav-link:active svg,
        [data-bs-theme=dark] .side-nav .side-nav-item .side-nav-link:focus i,
        [data-bs-theme=dark] .side-nav .side-nav-item .side-nav-link:focus .menu-text,
        [data-bs-theme=dark] .side-nav .side-nav-item .side-nav-link:focus svg {
            color: #ffffff !important;
        }

        /* Global Modal Footer Close/Cancel Button Override */
        .modal-footer .btn-light {
            background-color: #f3f4f6 !important;
            border: 1px solid #d1d5db !important;
            color: #374151 !important;
        }

        /* Dark mode compatibility for Close Button */
        [data-bs-theme=dark] .modal-footer .btn-light {
            background-color: #2a2b36 !important;
            border: 1px solid #4b4c56 !important;
            color: #d1d5db !important;
        }

        /* Static Sizing and Scroll for Large Tabbed Modals */
        .modal-body-static {
            min-height: 400px !important;
            max-height: 60vh !important;
            overflow-y: auto !important;
            overflow-x: hidden !important;
        }

        /* Dark Mode Compatibility Overrides */
        [data-bs-theme=dark] .card.bg-white, 
        [data-bs-theme=dark] .card-header.bg-white,
        [data-bs-theme=dark] .bg-white.rounded-3 {
            background-color: #1e2029 !important; /* matches the dark card background in the theme */
            border-color: rgba(255, 255, 255, 0.08) !important;
        }

        [data-bs-theme=dark] .text-dark,
        [data-bs-theme=dark] .fw-bold.text-dark,
        [data-bs-theme=dark] h3.text-dark,
        [data-bs-theme=dark] h4.text-dark,
        [data-bs-theme=dark] h5.text-dark,
        [data-bs-theme=dark] strong.text-dark,
        [data-bs-theme=dark] span.text-dark {
            color: #e2e8f0 !important; /* matches body text color in dark theme */
        }

        [data-bs-theme=dark] .border-light {
            border-color: rgba(255, 255, 255, 0.08) !important;
        }

        /* Align Notification Badge & Bell Icon */
        .topbar-item .dropdown {
            position: relative;
        }
        .topbar-link {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .topbar-badge {
            position: absolute !important;
            top: 4px !important;
            right: 4px !important;
            transform: translate(35%, -35%) !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            min-width: 15px !important;
            height: 15px !important;
            padding: 0 !important;
            border-radius: 50% !important; /* Sleek circle style */
            font-size: 9px !important;
            font-weight: 700 !important;
            line-height: 1 !important;
            border: 1.5px solid var(--bs-body-bg, #fff) !important;
            z-index: 10;
        }

        /* Glassmorphic Modal Backdrop & Light blending overlay */
        .modal-backdrop {
            backdrop-filter: blur(5px) !important;
            background-color: rgba(255, 255, 255, 0.3) !important; /* Light translucent overlay */
            transition: all 0.3s ease-in-out;
        }
        [data-bs-theme=dark] .modal-backdrop {
            background-color: rgba(15, 17, 23, 0.5) !important; /* Sleek dark translucent overlay */
        }

        /* Global Centered & Scrollable Modals styling */
        .modal-dialog {
            display: flex !important;
            align-items: center !important;
            min-height: calc(100% - 3.5rem) !important;
        }
        .modal-dialog-scrollable {
            height: calc(100% - 3.5rem) !important;
        }
        .modal-dialog-scrollable .modal-content {
            max-height: 100% !important;
            overflow: hidden !important;
        }
        .modal-content {
            border: 1px solid var(--ins-border-color) !important;
            border-radius: 6px !important;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08) !important;
        }
        
        /* Flex Form Fix for Scrollable Modals wrapping body in form */
        .modal-dialog-scrollable .modal-content form,
        .modal-dialog-scrollable .modal-content > form {
            display: flex !important;
            flex-direction: column !important;
            overflow: hidden !important;
            height: 100% !important;
            width: 100% !important;
            margin-bottom: 0 !important;
        }
        .modal-dialog-scrollable .modal-body {
            overflow-y: auto !important;
        }

        /* Webkit scrollbar for modal body to match sidebar scrollbar styling */
        .modal-body::-webkit-scrollbar {
            width: 6px !important;
            height: 6px !important;
        }
        .modal-body::-webkit-scrollbar-track {
            background: transparent !important;
        }
        .modal-body::-webkit-scrollbar-thumb {
            background: rgba(0, 0, 0, 0.2) !important;
            border-radius: 10px !important;
        }
        .modal-body::-webkit-scrollbar-thumb:hover {
            background: rgba(0, 0, 0, 0.35) !important;
        }
        
        /* Dark mode scrollbars */
        [data-bs-theme=dark] .modal-body::-webkit-scrollbar-thumb,
        [data-layout-mode="dark"] .modal-body::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.15) !important;
        }
        [data-bs-theme=dark] .modal-body::-webkit-scrollbar-thumb:hover,
        [data-layout-mode="dark"] .modal-body::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.25) !important;
        }
    </style>
</head>
<body>
    <div class="wrapper">

        <!-- Topbar Start -->
        <header class="app-topbar">
            @Html.Partial("Header")
        </header>
        <!-- Topbar End -->
        <!-- Sidenav Menu Start -->
        <div class="sidenav-menu">
            @Html.Action("RenderSidebar", "Sidebar")
        </div>
        <!-- Sidenav Menu End -->

        <div class="content-page">

            @RenderBody()

            <!-- Footer Start -->
            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6 text-center text-md-start">
                            &copy;
                            <script>document.write(new Date().getFullYear())</script> Zentora By <a href="https://github.com/digvijaysingh2004-sd" target="_blank" class="fw-semibold">digvijaysingh2004-sd</a>
                        </div>
                        <div class="col-md-6">
                            <div class="text-md-end d-none d-md-block">
                                59.5GB of <span class="fw-bold">200GB</span> Free.
                            </div>
                        </div>
                    </div>
                </div>
            </footer>
            <!-- end Footer -->
        </div>
    </div>

    <!-- Vendor js -->
    <script src="~/assets/js/vendors.min.js"></script>

    <!-- App js -->
    <script src="~/assets/js/app.js"></script>

    <!-- Choises.js Plugin Js -->
    <script src="~/assets/plugins/choices/choices.min.js"></script>

    <!-- Choices Demo Js-->
    <script src="~/assets/js/pages/form-choice.js"></script>

    <!-- Dashboard Page js -->
    <script src="~/assets/js/pages/dashboard.js"></script>

    <!-- Datatables js -->
    <script src="~/assets/plugins/datatables/dataTables.min.js"></script>
    <script src="~/assets/plugins/datatables/dataTables.bootstrap5.min.js"></script>
    <script src="~/assets/plugins/datatables/dataTables.responsive.min.js"></script>
    <script src="~/assets/plugins/datatables/responsive.bootstrap5.min.js"></script>
    <script src="~/assets/plugins/datatables/dataTables.select.min.js"></script>
    <script src="~/assets/plugins/datatables/select.bootstrap5.min.js"></script>


    <!-- Page js -->
    <script src="~/assets/js/pages/datatables-checkbox-select.js"></script>
    <script>
        $(document).on("click", "#logoutBtn", function () {
            $.ajax({
                url: '/Auth/Logout',
                type: 'POST',
                success: function (response) {
                    if (response.success) {
                        // Force redirect to login
                        window.location.href = '/';
                    }
                },
                error: function () {
                    alert("Logout failed. Please try again.");
                }
            });
        });
    </script>
    <script>
        @Html.Raw("var sessionUserId = " + Json.Encode(Session["UserId"]) + ";")
        if (!sessionUserId) {
            // if no session, always go to login
            if (window.location.pathname.toLowerCase().indexOf("/") === -1) {
                window.location.replace("/");
            }
        }
    </script>

    <script>
        toastr.options = {
            "closeButton": true,
            "debug": false,
            "newestOnTop": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "preventDuplicates": true,
            "timeOut": "3000",
            "extendedTimeOut": "1000",
            "showDuration": "300",
            "hideDuration": "1000",
            "showEasing": "swing",
            "hideEasing": "linear",
            "showMethod": "fadeIn",
            "hideMethod": "fadeOut"
        };
    </script>
    @if (Session["ErrorMessage"] != null)
    {
        <script>
            $(document).ready(function () {
                toastr.error("@Session["ErrorMessage"]");
            });
        </script>
        Session["ErrorMessage"] = null;
    }
    <script>
        $(document).ready(function () {
            // 1. Sleek dynamic page header & breadcrumb transformation
            var legacyTitleRow = $('.container-fluid > .row.justify-content-center.py-5');
            if (legacyTitleRow.length > 0) {
                var currentLoc = window.location.pathname.toLowerCase();
                if (currentLoc !== '/' && currentLoc !== '/home/index' && currentLoc !== '/home') {
                    var pageTitle = legacyTitleRow.find('h3').text().trim();
                    var dashboardUrl = legacyTitleRow.find('.badge-default').attr('href') || '/Home/Index';
                    
                    legacyTitleRow.hide();
                    
                    // Match the active page in the sidebar hierarchy to get accurate breadcrumbs
                    var currentPath = window.location.pathname.replace(/\/$/, "").toLowerCase();
                    var activeLink = $();
                    $('.side-nav a').each(function() {
                        var href = $(this).attr('href');
                        if (href && href !== '#') {
                            var cleanHref = href.replace(/\/$/, "").toLowerCase();
                            if (cleanHref === currentPath) {
                                activeLink = $(this);
                                return false; // break loop
                            }
                        }
                    });

                    var breadcrumbHtml = '';

                    if (activeLink.length > 0) {
                        var segments = [];
                        
                        // Add active item
                        segments.push(activeLink.find('.menu-text').text().trim());

                        // Walk up parent menus (collapses)
                        var parentCollapse = activeLink.closest('.collapse');
                        while (parentCollapse.length > 0) {
                            var triggerLink = $('a[href="#' + parentCollapse.attr('id') + '"]');
                            if (triggerLink.length > 0) {
                                segments.push(triggerLink.find('.menu-text').text().trim());
                            }
                            parentCollapse = triggerLink.closest('.collapse');
                        }

                        segments.reverse();

                        for (var i = 0; i < segments.length; i++) {
                            if (i === segments.length - 1) {
                                breadcrumbHtml += '<li class="breadcrumb-item active text-muted" aria-current="page">' + segments[i] + '</li>';
                            } else {
                                breadcrumbHtml += '<li class="breadcrumb-item text-secondary">' + segments[i] + '</li>';
                            }
                        }

                        if (!pageTitle) {
                            pageTitle = segments[segments.length - 1];
                        }
                    } else {
                        // Fallback: parse URL path if page is not linked in sidebar
                        var path = window.location.pathname.split('/').filter(function (el) { return el.length > 0; });
                        for (var i = 0; i < path.length; i++) {
                            var segment = path[i];
                            var segmentName = segment.replace(/([A-Z])/g, ' $1').trim();
                            segmentName = segmentName.split(' ').map(function(word) {
                                return word.charAt(0).toUpperCase() + word.slice(1);
                            }).join(' ');
                            
                            if (segmentName.toLowerCase() === 'index' && i === path.length - 1) {
                                continue;
                            }
                            
                            if (i === path.length - 1) {
                                breadcrumbHtml += '<li class="breadcrumb-item active text-muted" aria-current="page">' + (pageTitle || segmentName) + '</li>';
                            } else {
                                breadcrumbHtml += '<li class="breadcrumb-item text-secondary">' + segmentName + '</li>';
                            }
                        }
                    }
                    
                    var headerHtml = `
                        <div class="row mb-4 mt-3">
                            <div class="col-12">
                                <div class="card p-3 rounded-3 shadow-sm mb-0">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div>
                                            <h4 class="mb-1 fw-bold fs-5">${pageTitle || "Page Title"}</h4>
                                            <p class="text-muted mb-0 fs-xxs" style="font-size: 11px;">Configure and manage ${pageTitle || "settings"}</p>
                                        </div>
                                        <nav aria-label="breadcrumb">
                                            <ol class="breadcrumb mb-0 bg-transparent p-0" style="font-size: 13px;">
                                                ${breadcrumbHtml}
                                            </ol>
                                        </nav>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                    
                    $('.content-page .container-fluid').first().prepend(headerHtml);
                    
                    if (typeof lucide !== 'undefined') {
                        lucide.createIcons();
                    }
                }
            }

            @Html.Raw("var userPerms = " + Json.Encode(ViewBag.CurrentPermissions ?? new List<string>()) + ";")
            if (userPerms && userPerms.length > 0) {
                // If the user does not have view permission, we might just hide the whole container, but usually view is base
                if (!userPerms.includes("add")) { 
                    $('.btn-add, .add-btn, [data-bs-target^="#Add"], [title="Add"]').hide(); 
                }
                if (!userPerms.includes("edit")) { 
                    $('.btn-edit, .edit-btn, [onclick^="Update"], [title="Update"], [title="Edit"]').hide(); 
                }
                if (!userPerms.includes("delete")) { 
                    $('.btn-delete, .delete-btn, [onclick^="Delete"], [title="Delete"]').hide(); 
                }
            }

            // Mouseenter event delegation to convert title tooltips dynamically
            $(document).on('mouseenter', '.table .btn-soft-primary, .table .btn-soft-info, .table .btn-soft-danger, .table .btn-soft-success, .table .btn-soft-warning', function() {
                var $this = $(this);
                var title = $this.attr('title');
                if (title) {
                    $this.attr('data-tooltip', title);
                    $this.removeAttr('title');
                }
            });

            // Dynamically force all modal dialogs in the app to be centered and scrollable
            $('.modal-dialog').addClass('modal-dialog-centered modal-dialog-scrollable');
        });

        // Global Validator for forms (supporting Choices.js validation state)
        function validateForm(formId) {
            var isValid = true;
            $('#' + formId + ' .is-invalid').removeClass('is-invalid');
            $('#' + formId + ' .choices').removeClass('is-invalid');
            
            $('#' + formId + ' [required]').each(function () {
                var $el = $(this);
                var val = $el.val();
                
                if (!val || val.toString().trim() === '') {
                    isValid = false;
                    $el.addClass('is-invalid');
                    
                    var $container = $el.is('select') && $el.closest('.choices').length > 0 ? $el.closest('.choices') : $el;
                    if ($el.is('select')) {
                        $container.addClass('is-invalid');
                    }
                    
                    var $feedback = $container.siblings('.invalid-feedback');
                    
                    var labelText = '';
                    var fieldId = $el.attr('id');
                    if (fieldId) {
                        labelText = $('label[for="' + fieldId + '"]').text();
                    }
                    if (!labelText) {
                        labelText = $el.closest('.mb-3, .col-md-6, .col-md-4, .col-md-12').find('label').text();
                    }
                    labelText = labelText.replace('*', '').trim() || 'this field';
                    
                    var msg = $el.is('select') ? 'Please select the ' + labelText + '.' : 'Please enter the ' + labelText + '.';
                    if ($feedback.length === 0) {
                        $container.parent().append('<div class="invalid-feedback">' + msg + '</div>');
                    } else {
                        $feedback.text(msg);
                    }
                }
            });


            return isValid;
        }
    </script>
</body>
</html>
